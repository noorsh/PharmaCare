@model PharmaCare.MVC.Controllers.SetupViewModel
@{
    ViewData["Title"] = "System Setup";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PharmaCare - System Setup</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-100">
    <div class="min-h-screen flex items-center justify-center p-4">
        <div class="max-w-2xl w-full space-y-6">
            <!-- Header -->
            <div class="text-center">
                <h1 class="text-4xl font-bold text-gray-900 mb-2">PharmaCare Setup</h1>
                <p class="text-gray-600">Initial system configuration</p>
                <p class="text-sm text-red-600 font-semibold mt-2">⚠️ DELETE SetupController.cs AFTER SETUP!</p>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg">
                    ✅ @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg">
                    ❌ @TempData["Error"]
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="bg-blue-50 border border-blue-200 text-blue-800 px-4 py-3 rounded-lg">
                    ℹ️ @TempData["Info"]
                </div>
            }

            <!-- System Status -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-2xl font-bold mb-4">System Status</h2>
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="font-medium">Roles Created:</span>
                        @if (Model.RolesExist)
                        {
                            <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-semibold">✅ Yes</span>
                        }
                        else
                        {
                            <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-semibold">❌ No</span>
                        }
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="font-medium">Admin User Exists:</span>
                        @if (Model.AdminExists)
                        {
                            <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-semibold">✅ Yes</span>
                        }
                        else
                        {
                            <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-semibold">❌ No</span>
                        }
                    </div>
                    @if (Model.CurrentUserRoles.Any())
                    {
                        <div class="flex items-center justify-between">
                            <span class="font-medium">Your Current Roles:</span>
                            <div class="flex gap-2">
                                @foreach (var role in Model.CurrentUserRoles)
                                {
                                    <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-semibold">@role</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Step 1: Create Roles -->
            @if (!Model.RolesExist)
            {
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h2 class="text-xl font-bold mb-4">Step 1: Create Roles</h2>
                    <p class="text-gray-600 mb-4">Create the three main roles: Admin, Pharmacist, Patient</p>
                    <form asp-action="CreateRoles" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-colors">
                            Create All Roles
                        </button>
                    </form>
                </div>
            }

            <!-- Step 2: Create Admin User OR Make Current User Admin -->
            @if (Model.RolesExist && !Model.AdminExists)
            {
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h2 class="text-xl font-bold mb-4">Step 2: Create Admin User</h2>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Option A: Make current user admin -->
                        <div class="mb-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                            <h3 class="font-bold text-blue-900 mb-2">Quick Option: Make Yourself Admin</h3>
                            <p class="text-sm text-blue-800 mb-3">You are currently logged in. Click below to become an admin.</p>
                            <form asp-action="MakeCurrentUserAdmin" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition-colors">
                                    Make Me Admin
                                </button>
                            </form>
                        </div>
                        
                        <div class="text-center text-gray-500 my-4">— OR —</div>
                    }
                    
                    <!-- Option B: Create new admin user -->
                    <div>
                        <h3 class="font-bold mb-3">Create New Admin Account</h3>
                        <form asp-action="CreateAdminUser" method="post" class="space-y-4">
                            @Html.AntiForgeryToken()
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                                <input type="text" name="fullName" required 
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       placeholder="Admin User" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                                <input type="email" name="email" required 
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       placeholder="admin@pharmacare.com" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                                <input type="password" name="password" required 
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                       placeholder="Min 8 characters, 1 uppercase, 1 number" />
                                <p class="text-xs text-gray-500 mt-1">Password requirements: 8+ chars, 1 uppercase, 1 lowercase, 1 number</p>
                            </div>
                            <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg transition-colors">
                                Create Admin User
                            </button>
                        </form>
                    </div>
                </div>
            }

            <!-- All Done -->
            @if (Model.RolesExist && Model.AdminExists)
            {
                <div class="bg-green-50 border border-green-200 rounded-lg p-6">
                    <h2 class="text-2xl font-bold text-green-900 mb-4">✅ Setup Complete!</h2>
                    <p class="text-green-800 mb-4">Your system is ready to go!</p>
                    <div class="space-y-2 mb-6">
                        <p class="text-sm text-green-700">✓ All roles created</p>
                        <p class="text-sm text-green-700">✓ Admin user exists</p>
                    </div>
                    
                    <div class="bg-white rounded-lg p-4 mb-4">
                        <h3 class="font-bold mb-2">Next Steps:</h3>
                        <ol class="list-decimal list-inside space-y-1 text-sm">
                            <li>Login as Admin</li>
                            <li>Go to <code class="bg-gray-100 px-2 py-1 rounded">/Admin/Dashboard</code></li>
                            <li>Test that Patient users cannot access Admin dashboard</li>
                            <li><strong class="text-red-600">DELETE SetupController.cs and Setup folder!</strong></li>
                        </ol>
                    </div>

                    <div class="flex gap-3">
                        <a href="/Account/Login" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg text-center transition-colors">
                            Go to Login
                        </a>
                        <a href="/Admin/Dashboard" class="flex-1 bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg text-center transition-colors">
                            Admin Dashboard
                        </a>
                    </div>
                </div>
            }

            <!-- Instructions -->
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
                <h3 class="font-bold text-yellow-900 mb-2">⚠️ Security Warning</h3>
                <p class="text-sm text-yellow-800">
                    This Setup page is <strong>publicly accessible</strong> for initial configuration only. 
                    After creating your admin account, <strong>immediately delete</strong> the SetupController.cs 
                    and Views/Setup folder to secure your application!
                </p>
            </div>
        </div>
    </div>
</body>
</html>
