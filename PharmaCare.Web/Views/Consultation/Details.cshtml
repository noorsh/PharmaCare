@model PharmaCare.MVC.Models.ViewModels.ConsultationViewModel
@{
    ViewData["Title"] = "Consultation Details";
    Layout = "_LayoutAuth";

    var c     = Model.Consultation;
    var ai    = Model.AIAssessment;
    var rec   = c.Recommendation;
    var order = Model.MedicationOrder;

    var statusBorder = c.Status switch
    {
        "Completed"   => "border-l-emerald-500",
        "UnderReview" => "border-l-blue-500",
        "Cancelled"   => "border-l-slate-400",
        _             => "border-l-amber-500"
    };

    var statusBg = c.Status switch
    {
        "Completed"   => "bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800",
        "UnderReview" => "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 border-blue-200 dark:border-blue-800",
        "Cancelled"   => "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-700",
        _             => "bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 border-amber-200 dark:border-amber-800"
    };

    var statusIcon = c.Status switch
    {
        "Completed"   => "check_circle",
        "UnderReview" => "visibility",
        "Cancelled"   => "cancel",
        _             => "schedule"
    };

    var statusLabel = c.Status == "UnderReview" ? "In Progress" : c.Status;

    var severityBadge = c.SymptomSeverity switch
    {
        "Severe"   => "bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 border-red-100 dark:border-red-900/30",
        "Moderate" => "bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400 border-amber-100 dark:border-amber-900/30",
        "Mild"     => "bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border-emerald-100 dark:border-emerald-900/30",
        _          => "bg-slate-100 dark:bg-slate-800 text-slate-600 border-slate-200"
    };

    bool canOrder = User.IsInRole("Patient")
                   && c.Status == "Completed"
                   && rec?.InventoryId != null
                   && order == null;
}

<!-- Back + Title -->
<div class="mb-8">
    @if (User.IsInRole("Patient"))
    {
        <a asp-action="MyConsultations"
           class="flex items-center gap-1 text-primary text-sm font-medium mb-4 hover:underline w-fit">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back to My Consultations
        </a>
    }
    else
    {
        <a asp-action="History"
           class="flex items-center gap-1 text-primary text-sm font-medium mb-4 hover:underline w-fit">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back to History
        </a>
    }

    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="space-y-1">
            <div class="flex items-center gap-3 flex-wrap">
                <h2 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">Consultation Details</h2>
                <span class="bg-slate-100 dark:bg-slate-800 text-[#617789] text-xs font-bold px-2 py-1 rounded">
                    #PC-@c.ConsultationId.ToString("D4")
                </span>
                @if (order != null)
                {
                    var orderBadge = order.Status == "Dispatched"
                        ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200"
                        : "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200";
                    var orderIcon = order.Status == "Dispatched" ? "local_shipping" : "shopping_bag";
                    <span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-full border @orderBadge">
                        <span class="material-symbols-outlined text-sm">@orderIcon</span>
                        Order @order.Status
                    </span>
                }
            </div>
            <p class="text-[#617789] dark:text-slate-400">View the summary and professional recommendations for your consultation.</p>
        </div>
        <div class="flex items-center @statusBg px-4 py-1.5 rounded-full font-bold text-sm border">
            <span class="material-symbols-outlined text-sm mr-1.5">@statusIcon</span>
            @statusLabel
        </div>
    </div>
</div>

<div class="space-y-6 pb-32">

    <!-- 1. Summary Card -->
    <section class="bg-white dark:bg-[#1a2632] rounded-xl shadow-sm border border-[#e5e7eb] dark:border-[#2d3a4b] border-l-4 @statusBorder p-6 md:p-8">
        <div class="flex items-center gap-2 text-[#617789] mb-3">
            <span class="material-symbols-outlined text-lg">description</span>
            <span class="text-xs font-bold uppercase tracking-wider">Patient Summary</span>
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">@c.Symptoms</h3>

        @if (c.SymptomSeverity == "Severe")
        {
            <span class="inline-block mb-3 text-[10px] bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400 px-2 py-0.5 rounded-full font-black uppercase tracking-widest">
                ⚑ Urgent AI Flag
            </span>
        }

        <div class="flex flex-wrap gap-2 mt-3">
            <span class="text-xs font-semibold text-[#617789]">Submitted @c.CreatedAt.ToString("MMM dd, yyyy")</span>

            @if (!string.IsNullOrEmpty(c.SymptomDuration))
            {
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-slate-100 dark:bg-[#101a22] text-[#617789] text-xs font-medium border border-slate-200 dark:border-[#2d3a4b]">
                    <span class="material-symbols-outlined text-sm mr-1">schedule</span> @c.SymptomDuration
                </span>
            }

            @if (!string.IsNullOrEmpty(c.SymptomSeverity))
            {
                <span class="inline-flex items-center px-3 py-1 rounded-full @severityBadge text-xs font-medium border">
                    Severity: @c.SymptomSeverity
                </span>
            }
        </div>

        @if (c.Pharmacist != null)
        {
            <div class="mt-4 pt-4 border-t border-[#e5e7eb] dark:border-[#2d3a4b] flex items-center gap-2 text-sm text-[#617789]">
                <span class="material-symbols-outlined text-base">stethoscope</span>
                @if (c.Status == "UnderReview")
                {
                    <span>Currently being reviewed by <strong class="text-slate-800 dark:text-white">@c.Pharmacist.FirstName @c.Pharmacist.LastName</strong></span>
                }
                else if (c.Status == "Completed")
                {
                    <span>Reviewed by <strong class="text-slate-800 dark:text-white">@c.Pharmacist.FirstName @c.Pharmacist.LastName</strong>
                        @if (c.ReviewedAt.HasValue)
                        {
                            <text> on @c.ReviewedAt.Value.ToString("MMM dd, yyyy")</text>
                        }
                    </span>
                }
            </div>
        }
    </section>

    <!-- 2. AI Assessment Card -->
    @if (ai != null)
    {
        <section class="bg-white dark:bg-[#1a2632] rounded-xl shadow-sm border border-[#e5e7eb] dark:border-[#2d3a4b] overflow-hidden">
            <div class="bg-purple-50 dark:bg-purple-900/10 px-6 py-4 border-b border-purple-100 dark:border-purple-900/20 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-purple-600 dark:text-purple-400">psychology</span>
                    <span class="font-bold text-sm text-purple-900 dark:text-purple-300">AI Symptom Assessment</span>
                </div>
                @if (ai.ConfidenceScore.HasValue)
                {
                    <div class="bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300 px-2.5 py-0.5 rounded-full text-xs font-bold border border-purple-200 dark:border-purple-800">
                        @ai.ConfidenceScore.Value.ToString("F0")% Confidence
                    </div>
                }
            </div>
            <div class="p-6 md:p-8">
                <p class="text-[#617789] dark:text-slate-300 mb-6 leading-relaxed">@ai.AssessmentReport</p>

                @if (!string.IsNullOrEmpty(ai.PossibleConditions))
                {
                    <div class="mb-6">
                        <h4 class="text-xs font-bold text-[#617789] uppercase tracking-widest mb-3">Likely Conditions</h4>
                        <div class="flex flex-wrap gap-3">
                            @foreach (var condition in ai.PossibleConditions.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <div class="bg-slate-50 dark:bg-slate-800/50 p-3 rounded-lg border border-slate-100 dark:border-[#2d3a4b] flex items-center gap-3">
                                    <div class="w-2 h-2 rounded-full bg-purple-500 shrink-0"></div>
                                    <span class="text-sm font-semibold">@condition.Trim()</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(ai.RedFlags))
                {
                    <div class="mb-6 flex items-start gap-3 p-4 bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-900/30 rounded-lg">
                        <span class="material-symbols-outlined text-red-500 text-lg shrink-0">warning</span>
                        <div>
                            <p class="text-xs font-bold text-red-700 dark:text-red-400 uppercase tracking-wider mb-1">Red Flags</p>
                            <p class="text-sm text-red-700 dark:text-red-400">@ai.RedFlags</p>
                        </div>
                    </div>
                }

                <div class="flex items-start gap-3 p-4 bg-slate-50 dark:bg-[#101a22] rounded-lg">
                    <span class="material-symbols-outlined text-[#617789] text-lg shrink-0">info</span>
                    <p class="text-xs text-[#617789] leading-normal">
                        AI assessments are for informational purposes only and should be reviewed by a qualified pharmacist.
                        Do not use this as a substitute for professional medical advice.
                    </p>
                </div>
            </div>
        </section>
    }

    <!-- 3. Pharmacist Recommendation Card -->
    @if (rec != null && c.Status == "Completed")
    {
        <section class="bg-white dark:bg-[#1a2632] rounded-xl shadow-sm border border-emerald-500 p-6 md:p-8">
            <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 mb-6">
                <span class="material-symbols-outlined">verified_user</span>
                <span class="font-bold text-sm uppercase tracking-wider">Professional Review & Recommendation</span>
            </div>

            <!-- Notes -->
            <div class="bg-slate-50 dark:bg-[#101a22] border border-[#e5e7eb] dark:border-[#2d3a4b] rounded-xl p-5 italic text-slate-700 dark:text-slate-200 leading-relaxed relative mb-6">
                <span class="material-symbols-outlined absolute -top-3 -left-2 text-slate-200 dark:text-slate-700 text-4xl select-none">format_quote</span>
                "@rec.PharmacistNotes"
            </div>

            <div class="grid md:grid-cols-2 gap-8 items-end">
                <!-- Medication -->
                <div>
                    @if (rec.Inventory != null)
                    {
                        <h4 class="text-xs font-bold text-[#617789] uppercase tracking-widest mb-3">Recommended Medication</h4>
                        <div class="flex items-center gap-4 bg-primary/5 dark:bg-primary/10 border border-primary/20 p-4 rounded-xl">
                            <div class="bg-primary text-white w-12 h-12 rounded-lg flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-2xl">medication</span>
                            </div>
                            <div>
                                <p class="text-primary font-bold text-lg">@rec.Inventory.MedicineName</p>
                                @if (!string.IsNullOrEmpty(rec.Dosage))
                                {
                                    <p class="text-[#617789] text-sm">@rec.Dosage</p>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(rec.Instructions))
                    {
                        <div class="mt-4 p-4 bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/20 rounded-lg">
                            <p class="text-xs font-bold text-blue-700 dark:text-blue-400 uppercase tracking-wider mb-1">Instructions</p>
                            <p class="text-sm text-blue-700 dark:text-blue-300">@rec.Instructions</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(rec.Warnings))
                    {
                        <div class="mt-3 p-4 bg-amber-50 dark:bg-amber-900/10 border border-amber-100 dark:border-amber-900/20 rounded-lg">
                            <p class="text-xs font-bold text-amber-700 dark:text-amber-400 uppercase tracking-wider mb-1">Warnings</p>
                            <p class="text-sm text-amber-700 dark:text-amber-300">@rec.Warnings</p>
                        </div>
                    }

                    @if (rec.ReferToDoctor)
                    {
                        <div class="mt-3 p-4 bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-900/30 rounded-lg flex items-start gap-2">
                            <span class="material-symbols-outlined text-red-500 text-lg shrink-0">emergency</span>
                            <div>
                                <p class="text-xs font-bold text-red-700 dark:text-red-400 uppercase tracking-wider mb-1">Doctor Referral Recommended</p>
                                @if (!string.IsNullOrEmpty(rec.ReferralReason))
                                {
                                    <p class="text-sm text-red-700 dark:text-red-300">@rec.ReferralReason</p>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Pharmacist Info -->
                <div class="flex flex-col md:items-end">
                    <div class="text-right">
                        <p class="font-bold text-slate-900 dark:text-white">
                            @(rec.Pharmacist?.FirstName) @(rec.Pharmacist?.LastName)
                        </p>
                        <p class="text-[#617789] text-xs">
                            Reviewed on @rec.CreatedAt.ToString("MMM dd, yyyy")
                        </p>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- 4. Medication Order Section -->
    @if (c.Status == "Completed" && rec?.InventoryId != null)
    {
        <section class="bg-white dark:bg-[#1a2632] rounded-xl shadow-sm border border-[#e5e7eb] dark:border-[#2d3a4b] overflow-hidden">
            <div class="px-6 py-4 border-b border-[#e5e7eb] dark:border-[#2d3a4b] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">local_shipping</span>
                    <span class="font-bold text-sm uppercase tracking-wider">Medication Delivery</span>
                </div>
                @if (order != null)
                {
                    var badgeCss = order.Status == "Dispatched"
                        ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400"
                        : "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400";
                    <span class="text-xs font-bold px-3 py-1 rounded-full @badgeCss">
                        @order.Status
                    </span>
                }
            </div>

            <div class="p-6 md:p-8">

                @* ── No order yet — show order form to patient ── *@
                @if (order == null && User.IsInRole("Patient"))
                {
                    <p class="text-[#617789] text-sm mb-4">
                        Would you like to have <strong class="text-slate-800 dark:text-white">@rec.Inventory?.MedicineName</strong> delivered to your address?
                    </p>

                    <div id="orderFormContainer">
                        <button type="button" onclick="showOrderForm()"
                                class="flex items-center gap-2 bg-primary text-white font-bold px-5 py-2.5 rounded-lg hover:bg-primary/90 transition-all">
                            <span class="material-symbols-outlined text-lg">shopping_bag</span>
                            Order Medication
                        </button>
                    </div>

                    <div id="orderForm" class="hidden mt-4">
                        <form asp-controller="Order" asp-action="Place" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="consultationId" value="@c.ConsultationId" />

                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                        Delivery Address <span class="text-red-500">*</span>
                                    </label>
                                    <textarea name="deliveryAddress" rows="2" required
                                              placeholder="Enter your full delivery address..."
                                              class="w-full rounded-lg border border-[#e5e7eb] dark:border-[#2d3a4b] bg-slate-50 dark:bg-[#0f1923] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50"></textarea>
                                </div>

                                <div class="flex gap-3">
                                    <button type="submit"
                                            class="flex items-center gap-2 bg-primary text-white font-bold px-5 py-2.5 rounded-lg hover:bg-primary/90 transition-all">
                                        <span class="material-symbols-outlined text-lg">check</span>
                                        Confirm Order
                                    </button>
                                    <button type="button" onclick="hideOrderForm()"
                                            class="px-5 py-2.5 rounded-lg border border-[#e5e7eb] dark:border-[#2d3a4b] text-[#617789] font-semibold hover:bg-slate-50 dark:hover:bg-[#0f1923] transition-all">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                }

                @* ── Order exists — show status to patient ── *@
                @if (order != null && User.IsInRole("Patient"))
                {
                    <div class="flex items-start gap-4">
                        <div class="@(order.Status == "Dispatched" ? "bg-emerald-100 dark:bg-emerald-900/30" : "bg-amber-100 dark:bg-amber-900/30") w-12 h-12 rounded-lg flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined @(order.Status == "Dispatched" ? "text-emerald-600 dark:text-emerald-400" : "text-amber-600 dark:text-amber-400") text-2xl">
                                @(order.Status == "Dispatched" ? "local_shipping" : "inventory")
                            </span>
                        </div>
                        <div>
                            <p class="font-bold text-slate-800 dark:text-white">
                                @(order.Status == "Dispatched" ? "Your medication has been dispatched!" : "Your order is being prepared")
                            </p>
                            <p class="text-sm text-[#617789] mt-1">
                                <span class="material-symbols-outlined text-sm align-text-bottom">location_on</span>
                                @order.DeliveryAddress
                            </p>
                            <p class="text-xs text-[#617789] mt-1">Ordered on @order.OrderedAt.ToString("MMM dd, yyyy")</p>
                            @if (order.Status == "Dispatched" && !string.IsNullOrEmpty(order.PharmacistNotes))
                            {
                                <p class="text-sm text-emerald-700 dark:text-emerald-400 mt-2 font-medium">
                                    Note: @order.PharmacistNotes
                                </p>
                            }
                        </div>
                    </div>
                }

                @* ── Order exists — show to pharmacist with dispatch option ── *@
                @if (order != null && (User.IsInRole("Pharmacist") || User.IsInRole("Admin")))
                {
                    <div class="flex items-start gap-4 mb-4">
                        <div class="bg-amber-100 dark:bg-amber-900/30 w-12 h-12 rounded-lg flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-amber-600 dark:text-amber-400 text-2xl">shopping_bag</span>
                        </div>
                        <div class="flex-1">
                            <p class="font-bold text-slate-800 dark:text-white">Patient requested medication delivery</p>
                            <p class="text-sm text-[#617789] mt-1">
                                <span class="material-symbols-outlined text-sm align-text-bottom">medication</span>
                                @rec.Inventory?.MedicineName @(!string.IsNullOrEmpty(rec.Dosage) ? $"— {rec.Dosage}" : "")
                            </p>
                            <p class="text-sm text-[#617789] mt-1">
                                <span class="material-symbols-outlined text-sm align-text-bottom">location_on</span>
                                @order.DeliveryAddress
                            </p>
                            <p class="text-xs text-[#617789] mt-1">Ordered on @order.OrderedAt.ToString("MMM dd, yyyy 'at' HH:mm")</p>
                        </div>
                    </div>

                    @if (order.Status == "Pending")
                    {
                        <div id="dispatchFormContainer">
                            <button type="button" onclick="showDispatchForm()"
                                    class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-5 py-2.5 rounded-lg transition-all">
                                <span class="material-symbols-outlined text-lg">local_shipping</span>
                                Mark as Dispatched
                            </button>
                        </div>

                        <div id="dispatchForm" class="hidden mt-4">
                            <form asp-controller="Order" asp-action="Dispatch" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <input type="hidden" name="consultationId" value="@c.ConsultationId" />

                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                            Note to Patient (optional)
                                        </label>
                                        <input type="text" name="pharmacistNotes"
                                               placeholder="e.g. Expected delivery within 24 hours..."
                                               class="w-full rounded-lg border border-[#e5e7eb] dark:border-[#2d3a4b] bg-slate-50 dark:bg-[#0f1923] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" />
                                    </div>

                                    <div class="flex gap-3">
                                        <button type="submit"
                                                class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-5 py-2.5 rounded-lg transition-all">
                                            <span class="material-symbols-outlined text-lg">check</span>
                                            Confirm Dispatch
                                        </button>
                                        <button type="button" onclick="hideDispatchForm()"
                                                class="px-5 py-2.5 rounded-lg border border-[#e5e7eb] dark:border-[#2d3a4b] text-[#617789] font-semibold hover:bg-slate-50 dark:hover:bg-[#0f1923] transition-all">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-sm">
                            <span class="material-symbols-outlined">check_circle</span>
                            Dispatched on @order.DispatchedAt?.ToString("MMM dd, yyyy 'at' HH:mm")
                        </div>
                        @if (!string.IsNullOrEmpty(order.PharmacistNotes))
                        {
                            <p class="text-sm text-[#617789] mt-1">Note sent: @order.PharmacistNotes</p>
                        }
                    }
                }

                @* ── No order — show info to pharmacist ── *@
                @if (order == null && (User.IsInRole("Pharmacist") || User.IsInRole("Admin")))
                {
                    <p class="text-sm text-[#617789]">
                        <span class="material-symbols-outlined text-sm align-text-bottom">info</span>
                        Patient has not requested medication delivery yet.
                    </p>
                }
            </div>
        </section>
    }

    <!-- 5. Additional Information Card -->
    @if (!string.IsNullOrEmpty(c.AdditionalInformation))
    {
        <section class="bg-white dark:bg-[#1a2632] rounded-xl shadow-sm border border-[#e5e7eb] dark:border-[#2d3a4b] p-6 md:p-8">
            <div class="flex items-center gap-2 text-[#617789] mb-4">
                <span class="material-symbols-outlined">chat</span>
                <span class="text-xs font-bold uppercase tracking-wider">Additional Information You Provided</span>
            </div>
            <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-line">@c.AdditionalInformation</p>
        </section>
    }

</div>

@if (User.IsInRole("Patient"))
{
    <!-- Fixed Bottom Action Bar -->
    <div class="fixed bottom-0 left-0 lg:left-64 right-0 bg-white/90 dark:bg-[#1a2632]/90 backdrop-blur-md border-t border-[#e5e7eb] dark:border-[#2d3a4b] py-4 px-6 z-40">
        <div class="max-w-4xl mx-auto flex flex-col md:flex-row gap-3 items-center justify-between">
            <a asp-action="MyConsultations"
               class="w-full md:w-auto px-6 py-3 rounded-lg text-[#617789] font-bold hover:bg-slate-100 dark:hover:bg-[#101a22] transition-colors flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-xl">arrow_back</span>
                Back to My Consultations
            </a>
            <div class="flex gap-3 w-full md:w-auto">
                @if (c.Status == "Pending")
                {
                    <form asp-action="Cancel" asp-route-id="@c.ConsultationId" method="post"
                          onsubmit="return confirm('Cancel this consultation?')"
                          class="w-full md:w-auto">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="w-full px-6 py-3 rounded-lg border border-red-300 text-red-600 font-bold hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-xl">cancel</span>
                            Cancel Consultation
                        </button>
                    </form>
                }
                @if (c.Status == "Completed")
                {
                    <a asp-action="Start"
                       class="w-full md:w-auto px-8 py-3 bg-primary text-white font-bold rounded-lg shadow-lg shadow-primary/20 hover:bg-primary/90 transition-all flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-xl">add_circle</span>
                        Start New Consultation
                    </a>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function showOrderForm() {
            document.getElementById('orderFormContainer').classList.add('hidden');
            document.getElementById('orderForm').classList.remove('hidden');
        }

        function hideOrderForm() {
            document.getElementById('orderForm').classList.add('hidden');
            document.getElementById('orderFormContainer').classList.remove('hidden');
        }

        function showDispatchForm() {
            document.getElementById('dispatchFormContainer').classList.add('hidden');
            document.getElementById('dispatchForm').classList.remove('hidden');
        }

        function hideDispatchForm() {
            document.getElementById('dispatchForm').classList.add('hidden');
            document.getElementById('dispatchFormContainer').classList.remove('hidden');
        }
    </script>
}
