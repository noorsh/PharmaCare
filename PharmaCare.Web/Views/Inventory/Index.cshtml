@model PharmaCare.MVC.Models.ViewModels.InventoryViewModel
@{
    ViewData["Title"] = "Inventory Management";
    Layout = "_LayoutAuth";
}

<!-- Page Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
        <h1 class="text-[#111518] dark:text-white text-3xl font-black tracking-tight">Inventory Management</h1>
        <p class="text-[#617989] dark:text-slate-400 text-sm">Monitor stock levels, expiry dates, and pharmaceutical logistics.</p>
    </div>
    <button onclick="openAddModal()" class="flex items-center justify-center gap-2 rounded-lg bg-primary h-11 px-5 text-white text-sm font-bold shadow-sm hover:bg-blue-600 transition-all active:scale-95">
        <span class="material-symbols-outlined text-[20px]">add</span>
        Add New Item
    </button>
</div>

<!-- Statistics Cards -->
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
    <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border-l-4 border-primary shadow-sm">
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Total Items</p>
        <h3 class="text-2xl font-black">@Model.TotalUniqueItems</h3>
    </div>
    <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border-l-4 border-green-500 shadow-sm">
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Total Quantity</p>
        <h3 class="text-2xl font-black">@Model.TotalQuantity.ToString("N0")</h3>
    </div>
    <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border-l-4 border-amber-500 shadow-sm relative">
        <div class="flex items-center gap-2 mb-1">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Low Stock</p>
            @if (Model.LowStockCount > 0)
            {
                <span class="flex h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
            }
        </div>
        <h3 class="text-2xl font-black text-amber-600">@Model.LowStockCount</h3>
    </div>
    <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border-l-4 border-red-500 shadow-sm">
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Expired</p>
        <h3 class="text-2xl font-black text-red-600">@Model.ExpiredCount</h3>
    </div>
    <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border-l-4 border-orange-500 shadow-sm">
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Expiring Soon</p>
        <h3 class="text-2xl font-black text-orange-600">@Model.ExpiringSoonCount</h3>
    </div>
    <div class="bg-white dark:bg-slate-900 p-5 rounded-xl border-l-4 border-purple-500 shadow-sm">
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Total Value</p>
        <h3 class="text-2xl font-black">@Model.TotalValue.ToString("C0")</h3>
    </div>
</div>

<!-- Filters Bar -->
<div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-[#dbe1e6] dark:border-slate-800 flex flex-wrap gap-4 items-center mb-8">
    <form asp-action="Index" method="get" class="flex flex-wrap gap-4 items-center flex-1">
        <div class="relative flex-1 min-w-[240px]">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">search</span>
            <input name="search" value="@Model.SearchTerm" class="w-full pl-10 h-10 rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 text-sm focus:ring-primary focus:border-primary" placeholder="Search medicine name..." type="text"/>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <select name="category" class="h-10 rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 text-sm focus:ring-primary focus:border-primary min-w-[140px]" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @if (Model.CategoryFilter == "Pain Relief")
                {
                    <option value="Pain Relief" selected>Pain Relief</option>
                }
                else
                {
                    <option value="Pain Relief">Pain Relief</option>
                }
                @if (Model.CategoryFilter == "Antibiotics")
                {
                    <option value="Antibiotics" selected>Antibiotics</option>
                }
                else
                {
                    <option value="Antibiotics">Antibiotics</option>
                }
                @if (Model.CategoryFilter == "Vitamins")
                {
                    <option value="Vitamins" selected>Vitamins</option>
                }
                else
                {
                    <option value="Vitamins">Vitamins</option>
                }
                @if (Model.CategoryFilter == "Cardiac")
                {
                    <option value="Cardiac" selected>Cardiac</option>
                }
                else
                {
                    <option value="Cardiac">Cardiac</option>
                }
            </select>
            <select name="stock" class="h-10 rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 text-sm focus:ring-primary focus:border-primary min-w-[140px]" onchange="this.form.submit()">
                <option value="">Stock Status</option>
                @if (Model.StockFilter == "InStock")
                {
                    <option value="InStock" selected>In Stock</option>
                }
                else
                {
                    <option value="InStock">In Stock</option>
                }
                @if (Model.StockFilter == "LowStock")
                {
                    <option value="LowStock" selected>Low Stock</option>
                }
                else
                {
                    <option value="LowStock">Low Stock</option>
                }
            </select>
            <select name="expiry" class="h-10 rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 text-sm focus:ring-primary focus:border-primary min-w-[140px]" onchange="this.form.submit()">
                <option value="">Expiry Filter</option>
                @if (Model.ExpiryFilter == "Expired")
                {
                    <option value="Expired" selected>Expired</option>
                }
                else
                {
                    <option value="Expired">Expired</option>
                }
                @if (Model.ExpiryFilter == "ExpiringSoon")
                {
                    <option value="ExpiringSoon" selected>Expiring Soon</option>
                }
                else
                {
                    <option value="ExpiringSoon">Expiring Soon</option>
                }
            </select>
            <button type="submit" class="h-10 px-4 flex items-center gap-2 text-sm font-semibold bg-primary text-white rounded-lg hover:bg-blue-600">
                Apply
            </button>
        </div>
        @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.CategoryFilter) || !string.IsNullOrEmpty(Model.StockFilter) || !string.IsNullOrEmpty(Model.ExpiryFilter))
        {
            <a asp-action="Index" class="text-sm text-primary hover:underline font-medium">Clear Filters</a>
        }
    </form>
</div>

<!-- Inventory Table -->
<div class="bg-white dark:bg-slate-900 rounded-xl border border-[#dbe1e6] dark:border-slate-800 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800">
                    <th class="p-4 text-xs font-bold uppercase text-slate-500">Medicine Name</th>
                    <th class="p-4 text-xs font-bold uppercase text-slate-500">Category</th>
                    <th class="p-4 text-xs font-bold uppercase text-slate-500">Stock</th>
                    <th class="p-4 text-xs font-bold uppercase text-slate-500">Price</th>
                    <th class="p-4 text-xs font-bold uppercase text-slate-500">Reorder Level</th>
                    <th class="p-4 text-xs font-bold uppercase text-slate-500">Expiry Date</th>
                    <th class="p-4 text-xs font-bold uppercase text-slate-500 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var item in Model.InventoryItems)
                {
                    var rowClass = item.IsExpired ? "bg-red-50/40 dark:bg-red-900/10 hover:bg-red-50 dark:hover:bg-red-900/20" :
                                   item.IsLowStock ? "bg-amber-50/40 dark:bg-amber-900/10 hover:bg-amber-50 dark:hover:bg-amber-900/20" :
                                   "hover:bg-slate-50 dark:hover:bg-slate-800/50";
                    
                    var iconColor = item.IsExpired ? "bg-red-100 text-red-500" :
                                    item.IsLowStock ? "bg-primary/10 text-primary" :
                                    "bg-slate-100 dark:bg-slate-800 text-slate-500";
                    
                    <tr class="@rowClass transition-colors">
                        <td class="p-4">
                            <div class="flex items-center gap-3">
                                <div class="size-9 rounded-lg @iconColor flex items-center justify-center">
                                    <span class="material-symbols-outlined">pill</span>
                                </div>
                                <div>
                                    <p class="font-bold text-[#111518] dark:text-white">@item.MedicineName</p>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="text-[10px] text-slate-500">@item.Description</p>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="p-4">
                            @if (!string.IsNullOrEmpty(item.Category))
                            {
                                <span class="px-2 py-1 rounded text-[10px] font-bold uppercase bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400">@item.Category</span>
                            }
                        </td>
                        <td class="p-4">
                            @if (item.IsLowStock)
                            {
                                <span class="px-2 py-1 rounded-lg bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-400 font-black text-base">@item.QuantityInStock</span>
                            }
                            else
                            {
                                <span class="font-black text-base">@item.QuantityInStock</span>
                            }
                            <span class="text-xs text-slate-500 ml-1">@item.Unit</span>
                        </td>
                        <td class="p-4 font-medium">@item.Price.ToString("C")</td>
                        <td class="p-4 text-slate-500">@item.ReorderLevel</td>
                        <td class="p-4">
                            @if (item.IsExpired)
                            {
                                <span class="text-sm font-bold text-red-600 dark:text-red-400">EXPIRED</span>
                            }
                            else if (item.IsExpiringSoon)
                            {
                                <span class="text-sm font-bold text-orange-600 dark:text-orange-400">@item.ExpiryDate?.ToString("MMM dd, yyyy")</span>
                            }
                            else if (item.ExpiryDate.HasValue)
                            {
                                <span class="text-sm font-semibold text-green-600 dark:text-green-400">@item.ExpiryDate.Value.ToString("MMM dd, yyyy")</span>
                            }
                            else
                            {
                                <span class="text-sm text-slate-400">No expiry</span>
                            }
                        </td>
                        <td class="p-4 text-right">
                            <div class="flex justify-end gap-2">
                                <button onclick="openStockModal(@item.InventoryId, '@item.MedicineName', @item.QuantityInStock, '@item.Unit')" class="p-1.5 rounded hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500" title="Update Stock">
                                    <span class="material-symbols-outlined text-[20px]">inventory_2</span>
                                </button>
                                <button onclick='openEditModal(@Json.Serialize(new { 
                                    id = item.InventoryId, 
                                    name = item.MedicineName, 
                                    description = item.Description,
                                    quantity = item.QuantityInStock, 
                                    unit = item.Unit, 
                                    price = item.Price, 
                                    reorderLevel = item.ReorderLevel, 
                                    expiryDate = item.ExpiryDate?.ToString("yyyy-MM-dd"),
                                    manufacturer = item.Manufacturer,
                                    category = item.Category
                                }))' class="p-1.5 rounded hover:bg-slate-100 dark:hover:bg-slate-800 text-primary" title="Edit">
                                    <span class="material-symbols-outlined text-[20px]">edit</span>
                                </button>
                                <button onclick="confirmDelete(@item.InventoryId, '@item.MedicineName')" class="p-1.5 rounded hover:bg-slate-100 dark:hover:bg-slate-800 text-red-500" title="Delete">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="p-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <p class="text-sm text-slate-500">
            Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) - @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) of @Model.TotalItems items
        </p>
        <div class="flex gap-2">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm" asp-route-category="@Model.CategoryFilter" asp-route-stock="@Model.StockFilter" asp-route-expiry="@Model.ExpiryFilter"
                   class="px-3 py-1 border border-slate-200 dark:border-slate-700 rounded hover:bg-slate-50 dark:hover:bg-slate-800 text-sm font-medium">
                    Previous
                </a>
            }
            else
            {
                <button class="px-3 py-1 border border-slate-200 dark:border-slate-700 rounded text-sm font-medium opacity-50 cursor-not-allowed" disabled>Previous</button>
            }
            
            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
            {
                if (i == Model.CurrentPage)
                {
                    <button class="px-3 py-1 bg-primary text-white rounded text-sm font-medium">@i</button>
                }
                else
                {
                    <a asp-action="Index" asp-route-page="@i" asp-route-search="@Model.SearchTerm" asp-route-category="@Model.CategoryFilter" asp-route-stock="@Model.StockFilter" asp-route-expiry="@Model.ExpiryFilter"
                       class="px-3 py-1 border border-slate-200 dark:border-slate-700 rounded hover:bg-slate-50 dark:hover:bg-slate-800 text-sm font-medium">
                        @i
                    </a>
                }
            }
            
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm" asp-route-category="@Model.CategoryFilter" asp-route-stock="@Model.StockFilter" asp-route-expiry="@Model.ExpiryFilter"
                   class="px-3 py-1 border border-slate-200 dark:border-slate-700 rounded hover:bg-slate-50 dark:hover:bg-slate-800 text-sm font-medium">
                    Next
                </a>
            }
            else
            {
                <button class="px-3 py-1 border border-slate-200 dark:border-slate-700 rounded text-sm font-medium opacity-50 cursor-not-allowed" disabled>Next</button>
            }
        </div>
    </div>
</div>

<!-- Add Item Modal -->
<div id="addModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-slate-900 rounded-xl max-w-3xl w-full p-6 shadow-2xl my-8">
        <h2 class="text-2xl font-bold mb-6">Add New Item</h2>
        <form asp-action="Add" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Column 1 -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold mb-2">Medicine Name *</label>
                        <input type="text" name="MedicineName" required class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" placeholder="e.g., Paracetamol 500mg" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Quantity in Stock *</label>
                        <input type="number" name="QuantityInStock" required min="0" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" placeholder="100" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Unit *</label>
                        <select name="Unit" required class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary">
                            <option value="tablets">Tablets</option>
                            <option value="bottles">Bottles</option>
                            <option value="boxes">Boxes</option>
                            <option value="ml">ML</option>
                            <option value="mg">MG</option>
                            <option value="grams">Grams</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Price *</label>
                        <input type="number" name="Price" required step="0.01" min="0" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" placeholder="10.50" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Reorder Level *</label>
                        <input type="number" name="ReorderLevel" required min="0" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" placeholder="20" />
                        <p class="text-xs text-slate-500 mt-1">Alert when stock reaches this level</p>
                    </div>
                </div>
                
                <!-- Column 2 -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold mb-2">Category</label>
                        <select name="Category" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary">
                            <option value="">Select category...</option>
                            <option value="Pain Relief">Pain Relief</option>
                            <option value="Antibiotics">Antibiotics</option>
                            <option value="Vitamins">Vitamins</option>
                            <option value="Cardiac">Cardiac</option>
                            <option value="Diabetes">Diabetes</option>
                            <option value="First Aid">First Aid</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Manufacturer</label>
                        <input type="text" name="Manufacturer" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" placeholder="e.g., Pfizer" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Expiry Date</label>
                        <input type="date" name="ExpiryDate" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" />
                        <p class="text-xs text-slate-500 mt-1">Leave blank if no expiry</p>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Description</label>
                        <textarea name="Description" rows="3" maxlength="500" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" placeholder="Additional details..."></textarea>
                    </div>
                </div>
            </div>
            <div class="flex gap-3 justify-end pt-4 border-t">
                <button type="button" onclick="closeAddModal()" class="px-5 py-2.5 rounded-lg font-semibold text-slate-600 hover:bg-slate-100">
                    Cancel
                </button>
                <button type="submit" class="bg-primary text-white px-6 py-2.5 rounded-lg font-semibold hover:opacity-90">
                    Add Item
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Item Modal -->
<div id="editModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-slate-900 rounded-xl max-w-3xl w-full p-6 shadow-2xl my-8">
        <h2 class="text-2xl font-bold mb-6">Edit Item</h2>
        <form asp-action="Edit" method="post" id="editForm" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="InventoryId" id="editId" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Same fields as Add, but with id attributes for pre-filling -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold mb-2">Medicine Name *</label>
                        <input type="text" name="MedicineName" id="editName" required class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Quantity in Stock *</label>
                        <input type="number" name="QuantityInStock" id="editQuantity" required min="0" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Unit *</label>
                        <select name="Unit" id="editUnit" required class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary">
                            <option value="tablets">Tablets</option>
                            <option value="bottles">Bottles</option>
                            <option value="boxes">Boxes</option>
                            <option value="ml">ML</option>
                            <option value="mg">MG</option>
                            <option value="grams">Grams</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Price *</label>
                        <input type="number" name="Price" id="editPrice" required step="0.01" min="0" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Reorder Level *</label>
                        <input type="number" name="ReorderLevel" id="editReorderLevel" required min="0" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" />
                    </div>
                </div>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold mb-2">Category</label>
                        <select name="Category" id="editCategory" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary">
                            <option value="">Select category...</option>
                            <option value="Pain Relief">Pain Relief</option>
                            <option value="Antibiotics">Antibiotics</option>
                            <option value="Vitamins">Vitamins</option>
                            <option value="Cardiac">Cardiac</option>
                            <option value="Diabetes">Diabetes</option>
                            <option value="First Aid">First Aid</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Manufacturer</label>
                        <input type="text" name="Manufacturer" id="editManufacturer" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Expiry Date</label>
                        <input type="date" name="ExpiryDate" id="editExpiryDate" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Description</label>
                        <textarea name="Description" id="editDescription" rows="3" maxlength="500" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary"></textarea>
                    </div>
                </div>
            </div>
            <div class="flex gap-3 justify-end pt-4 border-t">
                <button type="button" onclick="closeEditModal()" class="px-5 py-2.5 rounded-lg font-semibold text-slate-600 hover:bg-slate-100">
                    Cancel
                </button>
                <button type="submit" class="bg-primary text-white px-6 py-2.5 rounded-lg font-semibold hover:opacity-90">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Quick Stock Update Modal -->
<div id="stockModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-xl max-w-md w-full p-6 shadow-2xl">
        <h2 class="text-2xl font-bold mb-4">Update Stock</h2>
        <form asp-action="UpdateStock" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="stockId" />
            <div>
                <label class="block text-sm font-semibold mb-2">Medicine</label>
                <p id="stockName" class="text-lg font-bold text-slate-700 dark:text-slate-300"></p>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Current Stock</label>
                <p id="stockCurrent" class="px-3 py-2 bg-slate-100 dark:bg-slate-800 rounded font-bold text-slate-700 dark:text-slate-300"></p>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">New Quantity *</label>
                <input type="number" name="quantity" id="stockNewQuantity" required min="0" class="w-full rounded-lg border-slate-300 focus:ring-primary focus:border-primary text-lg font-bold" />
            </div>
            <div class="flex gap-3 justify-end pt-4 border-t">
                <button type="button" onclick="closeStockModal()" class="px-5 py-2.5 rounded-lg font-semibold text-slate-600 hover:bg-slate-100">
                    Cancel
                </button>
                <button type="submit" class="bg-primary text-white px-6 py-2.5 rounded-lg font-semibold hover:opacity-90">
                    Update Stock
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-xl max-w-md w-full p-6 shadow-2xl">
        <div class="flex items-start gap-4 mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-100 text-red-600">
                <span class="material-symbols-outlined text-3xl">warning</span>
            </div>
            <div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Delete Item?</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400" id="deleteItemName"></p>
            </div>
        </div>
        <form asp-action="Delete" method="post" id="deleteForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteId" />
            <div class="flex gap-3 justify-end">
                <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-bold text-gray-600 hover:bg-gray-50">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-bold">
                    Yes, Delete
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Add Modal
        function openAddModal() {
            document.getElementById('addModal').classList.remove('hidden');
        }
        function closeAddModal() {
            document.getElementById('addModal').classList.add('hidden');
        }

        // Edit Modal
        function openEditModal(data) {
            document.getElementById('editId').value = data.id;
            document.getElementById('editName').value = data.name;
            document.getElementById('editDescription').value = data.description || '';
            document.getElementById('editQuantity').value = data.quantity;
            document.getElementById('editUnit').value = data.unit;
            document.getElementById('editPrice').value = data.price;
            document.getElementById('editReorderLevel').value = data.reorderLevel;
            document.getElementById('editExpiryDate').value = data.expiryDate || '';
            document.getElementById('editManufacturer').value = data.manufacturer || '';
            document.getElementById('editCategory').value = data.category || '';
            document.getElementById('editModal').classList.remove('hidden');
        }
        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        // Stock Modal
        function openStockModal(id, name, currentStock, unit) {
            document.getElementById('stockId').value = id;
            document.getElementById('stockName').textContent = name;
            document.getElementById('stockCurrent').textContent = currentStock + ' ' + unit;
            document.getElementById('stockNewQuantity').value = currentStock;
            document.getElementById('stockModal').classList.remove('hidden');
        }
        function closeStockModal() {
            document.getElementById('stockModal').classList.add('hidden');
        }

        // Delete Modal
        function confirmDelete(id, name) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteItemName').textContent = 'Are you sure you want to delete ' + name + '? This action cannot be undone.';
            document.getElementById('deleteModal').classList.remove('hidden');
        }
        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
        }

        // Close modals on Escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeAddModal();
                closeEditModal();
                closeStockModal();
                closeDeleteModal();
            }
        });

        // Close modals on background click
        document.querySelectorAll('[id$="Modal"]').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.add('hidden');
                }
            });
        });
    </script>
}
