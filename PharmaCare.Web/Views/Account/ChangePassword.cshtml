@model PharmaCare.MVC.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_LayoutAuth";
}

<div class="flex flex-col py-4 px-4">
    <div class="w-full max-w-[640px]">

        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-black tracking-tight mb-2">Change Password</h1>
            <p class="text-[#617789]">Update your account security credentials to keep your medical data safe.</p>
        </div>

        <!-- Card -->
        <div class="bg-white dark:bg-[#1a2632] rounded-xl shadow-sm border border-[#e5e7eb] dark:border-[#2d3a4b] p-8">
            <form asp-action="ChangePassword" method="post" id="changePasswordForm">
                @Html.AntiForgeryToken()

                <div class="space-y-6">

                    <!-- Current Password -->
                    <div class="space-y-2">
                        <label asp-for="CurrentPassword"
                               class="block text-sm font-semibold text-slate-700 dark:text-slate-300">
                            Current Password
                        </label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <span class="material-symbols-outlined text-[#617789] group-focus-within:text-primary transition-colors">lock</span>
                            </div>
                            <input asp-for="CurrentPassword"
                                   id="currentPassword"
                                   type="password"
                                   placeholder="Enter current password"
                                   class="block w-full pl-11 pr-12 py-3 bg-slate-50 dark:bg-[#0f1923] border border-[#e5e7eb] dark:border-[#2d3a4b] rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none" />
                            <button type="button" onclick="toggleVisibility('currentPassword', 'eyeIcon0')"
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center text-[#617789] hover:text-primary transition-colors">
                                <span id="eyeIcon0" class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-red-500 text-xs"></span>
                    </div>

                    <hr class="border-[#e5e7eb] dark:border-[#2d3a4b]" />

                    <!-- New Password -->
                    <div class="space-y-2">
                        <label asp-for="NewPassword"
                               class="block text-sm font-semibold text-slate-700 dark:text-slate-300">
                            New Password
                        </label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <span class="material-symbols-outlined text-[#617789] group-focus-within:text-primary transition-colors">lock_reset</span>
                            </div>
                            <input asp-for="NewPassword"
                                   id="newPassword"
                                   type="password"
                                   placeholder="Enter new password"
                                   oninput="updateStrength(this.value)"
                                   class="block w-full pl-11 pr-12 py-3 bg-slate-50 dark:bg-[#0f1923] border border-[#e5e7eb] dark:border-[#2d3a4b] rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none" />
                            <button type="button" onclick="toggleVisibility('newPassword', 'eyeIcon1')"
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center text-[#617789] hover:text-primary transition-colors">
                                <span id="eyeIcon1" class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                        </div>

                        <!-- Password Strength -->
                        <div class="pt-1">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-medium text-[#617789]">Password Strength</span>
                                <span id="strengthLabel" class="text-xs font-bold text-[#617789]">—</span>
                            </div>
                            <div class="h-1.5 w-full bg-slate-100 dark:bg-[#0f1923] rounded-full overflow-hidden">
                                <div id="strengthBar" class="h-full rounded-full transition-all duration-300 w-0 bg-slate-300"></div>
                            </div>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="space-y-2">
                        <label asp-for="ConfirmPassword"
                               class="block text-sm font-semibold text-slate-700 dark:text-slate-300">
                            Confirm New Password
                        </label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <span class="material-symbols-outlined text-[#617789] group-focus-within:text-primary transition-colors">lock_clock</span>
                            </div>
                            <input asp-for="ConfirmPassword"
                                   id="confirmPassword"
                                   type="password"
                                   placeholder="Re-enter new password"
                                   class="block w-full pl-11 pr-12 py-3 bg-slate-50 dark:bg-[#0f1923] border border-[#e5e7eb] dark:border-[#2d3a4b] rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none" />
                            <button type="button" onclick="toggleVisibility('confirmPassword', 'eyeIcon2')"
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center text-[#617789] hover:text-primary transition-colors">
                                <span id="eyeIcon2" class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- General errors -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="flex gap-3 p-4 bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800/30 rounded-lg">
                            <span class="material-symbols-outlined text-red-500 text-[20px]">error</span>
                            <div class="text-sm text-red-700 dark:text-red-300">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <p>@error.ErrorMessage</p>
                                }
                            </div>
                        </div>
                    }

                    <!-- Security tip -->
                    <div class="flex gap-3 p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800/30 rounded-lg">
                        <span class="material-symbols-outlined text-primary text-[20px]">info</span>
                        <p class="text-sm text-blue-700 dark:text-blue-300 leading-relaxed">
                            Passwords must be at least 8 characters and include a mix of letters, numbers, and symbols.
                        </p>
                    </div>

                    <!-- Buttons -->
                    <div class="flex flex-col sm:flex-row gap-3 pt-2">
                        <button type="submit"
                                class="flex-1 bg-primary hover:bg-primary/90 text-white font-bold py-3 px-6 rounded-xl transition-all shadow-md active:scale-[0.98]">
                            Update Password
                        </button>
                        <a asp-controller="@(User.IsInRole("Patient") ? "Patient" : User.IsInRole("Pharmacist") ? "Pharmacist" : "Admin")"
                           asp-action="Dashboard"
                           class="px-8 py-3 bg-white dark:bg-[#0f1923] border border-[#e5e7eb] dark:border-[#2d3a4b] text-[#617789] font-semibold rounded-xl hover:bg-slate-50 dark:hover:bg-[#1a2632] transition-all text-center">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <!-- Footer -->
        <div class="mt-8 text-center">
            <p class="text-[#617789] text-sm">
                Need help? <a href="#" class="text-primary font-semibold hover:underline">Contact PharmaCare Support</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        function updateStrength(value) {
            const bar = document.getElementById('strengthBar');
            const label = document.getElementById('strengthLabel');

            let score = 0;
            if (value.length >= 8)          score++;
            if (/[A-Z]/.test(value))        score++;
            if (/[0-9]/.test(value))        score++;
            if (/[^A-Za-z0-9]/.test(value)) score++;

            const levels = [
                { label: '—',        color: 'bg-slate-300',  width: 'w-0'    },
                { label: 'Weak',     color: 'bg-red-500',    width: 'w-1/4'  },
                { label: 'Fair',     color: 'bg-orange-500', width: 'w-2/4'  },
                { label: 'Good',     color: 'bg-amber-500',  width: 'w-3/4'  },
                { label: 'Strong',   color: 'bg-emerald-500',width: 'w-full' },
            ];

            const level = value.length === 0 ? levels[0] : levels[score] || levels[1];

            bar.className = `h-full rounded-full transition-all duration-300 ${level.width} ${level.color}`;
            label.textContent = level.label;
            label.className = `text-xs font-bold ${level.color.replace('bg-', 'text-')}`;
        }
    </script>
}