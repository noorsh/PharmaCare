@model PharmaCare.MVC.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PharmaCare - Reset Password</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: { "primary": "#1392ec", "background-light": "#f6f7f8", "background-dark": "#101a22" },
                    fontFamily: { "display": ["Inter", "sans-serif"] },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    </style>
</head>
<body class="font-display bg-background-light dark:bg-background-dark min-h-screen">
<div class="flex min-h-screen w-full flex-col lg:flex-row">

    @* ── Left: Form ──────────────────────────────────────────────────────── *@
    <div class="flex w-full flex-col justify-center bg-white px-8 py-12 dark:bg-background-dark lg:w-1/2 lg:px-24">
        <div class="mx-auto w-full max-w-md">

            <div class="mb-10 flex items-center gap-2">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-white">
                    <span class="material-symbols-outlined text-2xl">health_metrics</span>
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-[#111518] dark:text-white">PharmaCare</h1>
            </div>

            <div class="mb-8">
                <div class="flex items-center justify-center w-16 h-16 bg-primary/10 rounded-2xl mb-6">
                    <span class="material-symbols-outlined text-primary text-3xl">lock_open</span>
                </div>
                <h2 class="text-3xl font-black text-[#111518] dark:text-white">Set New Password</h2>
                <p class="mt-2 text-sm text-[#617789] dark:text-slate-400">
                    Your new password must be at least 8 characters long.
                </p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 rounded-lg bg-red-50 border border-red-200 p-4">
                    <div class="flex items-center gap-2 text-red-800">
                        <span class="material-symbols-outlined">error</span>
                        <div asp-validation-summary="All" class="text-sm"></div>
                    </div>
                </div>
            }

            <form asp-action="ResetPassword" asp-controller="Account" method="post" class="space-y-6">
                @Html.AntiForgeryToken()

                @* Hidden fields *@
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                @* New Password *@
                <div>
                    <label asp-for="NewPassword" class="mb-2 block text-sm font-medium text-[#111518] dark:text-white">
                        New Password
                    </label>
                    <div class="relative flex items-center">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-[#617789]">
                            <span class="material-symbols-outlined">lock</span>
                        </div>
                        <input asp-for="NewPassword"
                               id="newPassword"
                               type="password"
                               placeholder="••••••••"
                               autocomplete="new-password"
                               class="block h-12 w-full rounded-lg border border-[#dbe1e6] bg-white pl-11 pr-11 text-sm text-[#111518] focus:border-primary focus:ring-primary dark:border-slate-700 dark:bg-background-dark dark:text-white" />
                        <button type="button" onclick="toggleField('newPassword', 'icon1')"
                                class="absolute inset-y-0 right-0 flex items-center pr-4 text-[#617789]">
                            <span class="material-symbols-outlined text-xl" id="icon1">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                @* Confirm Password *@
                <div>
                    <label asp-for="ConfirmPassword" class="mb-2 block text-sm font-medium text-[#111518] dark:text-white">
                        Confirm New Password
                    </label>
                    <div class="relative flex items-center">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-[#617789]">
                            <span class="material-symbols-outlined">lock</span>
                        </div>
                        <input asp-for="ConfirmPassword"
                               id="confirmPassword"
                               type="password"
                               placeholder="••••••••"
                               autocomplete="new-password"
                               class="block h-12 w-full rounded-lg border border-[#dbe1e6] bg-white pl-11 pr-11 text-sm text-[#111518] focus:border-primary focus:ring-primary dark:border-slate-700 dark:bg-background-dark dark:text-white" />
                        <button type="button" onclick="toggleField('confirmPassword', 'icon2')"
                                class="absolute inset-y-0 right-0 flex items-center pr-4 text-[#617789]">
                            <span class="material-symbols-outlined text-xl" id="icon2">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <button type="submit"
                        class="flex w-full items-center justify-center gap-2 rounded-lg bg-primary py-3.5 text-base font-bold text-white transition-all hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
                    <span class="material-symbols-outlined text-xl">check_circle</span>
                    Reset Password
                </button>
            </form>

            <p class="mt-8 text-center text-sm text-[#617789] dark:text-slate-400">
                Remember your password?
                <a asp-action="Login" asp-controller="Account"
                   class="font-bold text-primary hover:underline">
                    Back to Login
                </a>
            </p>

            <div class="mt-12 flex items-center justify-center gap-2 opacity-60">
                <span class="material-symbols-outlined text-sm">verified_user</span>
                <span class="text-xs uppercase tracking-widest text-[#617789] dark:text-slate-400">
                    Secure AES-256 Authentication
                </span>
            </div>

        </div>
    </div>

    @* ── Right: Hero ──────────────────────────────────────────────────────── *@
    <div class="relative hidden lg:flex lg:w-1/2">
        <div class="h-full w-full bg-cover bg-center"
             style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDKWQkP_OTBcgDKghKLGB2B6Zc9XFI6g2g0yhhnT5CyrwsPLXUHJ8W7qys2Y6j2arERMYzQ-KXCsbS048ywTGWFmkoAE9SAjxWxc-BGWiFUyb8cHdfzP1XEgVCGtRViKGWQIe7D46LKh2l5qx6MApoUtpYPnHXjbB4WeJ8beJtbqPianVP7ywHHRU8ePEoKHyJy1J4V50Dir9JJHkkea9a8ACEZexpUxB5Dzj3I_HrfOF-sntCwLk39CkfFrRZzNrFS1sufliPn4Fwj');">
        </div>
        <div class="absolute inset-0 bg-primary/80 backdrop-blur-[2px]"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center px-12 text-center text-white">
            <div class="max-w-md">
                <h2 class="mb-6 text-5xl font-black leading-tight">Your Health, Our Priority</h2>
                <p class="mb-10 text-lg font-medium text-white/90">
                    Access real-time health insights, automated prescriptions, and dedicated support on the world's leading AI healthcare network.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <div class="flex items-center gap-2 rounded-full bg-white/20 px-4 py-2 backdrop-blur-md">
                        <span class="material-symbols-outlined text-teal-300">shield</span>
                        <span class="text-sm font-bold">HIPAA Compliant</span>
                    </div>
                    <div class="flex items-center gap-2 rounded-full bg-white/20 px-4 py-2 backdrop-blur-md">
                        <span class="material-symbols-outlined text-teal-300">group</span>
                        <span class="text-sm font-bold">10,000+ Active Users</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<partial name="_ValidationScriptsPartial" />
<script>
    function toggleField(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon  = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            icon.textContent = 'visibility';
        }
    }
</script>
</body>
</html>
