@{
    ViewData["Title"] = "Check Your Email";
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PharmaCare - Check Your Email</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: { "primary": "#1392ec", "background-light": "#f6f7f8", "background-dark": "#101a22" },
                    fontFamily: { "display": ["Inter", "sans-serif"] },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    </style>
</head>
<body class="font-display bg-background-light dark:bg-background-dark min-h-screen">
<div class="flex min-h-screen w-full flex-col lg:flex-row">

    <div class="flex w-full flex-col justify-center bg-white px-8 py-12 dark:bg-background-dark lg:w-1/2 lg:px-24">
        <div class="mx-auto w-full max-w-md">

            <div class="mb-10 flex items-center gap-2">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-white">
                    <span class="material-symbols-outlined text-2xl">health_metrics</span>
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-[#111518] dark:text-white">PharmaCare</h1>
            </div>

            <div class="text-center">
                <div class="flex items-center justify-center w-20 h-20 bg-green-100 dark:bg-green-500/10 rounded-2xl mx-auto mb-6">
                    <span class="material-symbols-outlined text-green-600 dark:text-green-400 text-4xl"
                          style="font-variation-settings:'FILL' 1;">mark_email_read</span>
                </div>
                <h2 class="text-3xl font-black text-[#111518] dark:text-white mb-3">Check Your Email</h2>
                <p class="text-sm text-[#617789] dark:text-slate-400 leading-relaxed mb-8">
                    If an account exists for that email address, we've sent a password reset link. Check your inbox — it should arrive within a few minutes.
                </p>

                <div class="bg-blue-50 dark:bg-primary/10 border border-blue-100 dark:border-primary/20 rounded-xl p-4 mb-8 text-left">
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-primary text-base mt-0.5">info</span>
                        <div class="text-sm text-[#617789] dark:text-slate-400">
                            <p class="font-semibold text-[#111518] dark:text-white mb-1">Didn't receive it?</p>
                            <ul class="space-y-1 list-disc list-inside">
                                <li>Check your spam or junk folder</li>
                                <li>Make sure you entered the correct email</li>
                                <li>The link expires in 24 hours</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <a asp-action="ForgotPassword" asp-controller="Account"
                   class="flex w-full items-center justify-center gap-2 rounded-lg border border-[#dbe1e6] dark:border-slate-700 py-3 text-sm font-semibold text-[#111518] dark:text-white hover:bg-gray-50 dark:hover:bg-slate-800 transition-all mb-4">
                    <span class="material-symbols-outlined text-base">refresh</span>
                    Resend Reset Link
                </a>

                <a asp-action="Login" asp-controller="Account"
                   class="flex w-full items-center justify-center gap-2 rounded-lg bg-primary py-3 text-sm font-bold text-white hover:bg-blue-600 transition-all">
                    <span class="material-symbols-outlined text-base">arrow_back</span>
                    Back to Login
                </a>
            </div>

            <div class="mt-12 flex items-center justify-center gap-2 opacity-60">
                <span class="material-symbols-outlined text-sm">verified_user</span>
                <span class="text-xs uppercase tracking-widest text-[#617789] dark:text-slate-400">
                    Secure AES-256 Authentication
                </span>
            </div>

        </div>
    </div>

    <div class="relative hidden lg:flex lg:w-1/2">
        <div class="h-full w-full bg-cover bg-center"
             style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDKWQkP_OTBcgDKghKLGB2B6Zc9XFI6g2g0yhhnT5CyrwsPLXUHJ8W7qys2Y6j2arERMYzQ-KXCsbS048ywTGWFmkoAE9SAjxWxc-BGWiFUyb8cHdfzP1XEgVCGtRViKGWQIe7D46LKh2l5qx6MApoUtpYPnHXjbB4WeJ8beJtbqPianVP7ywHHRU8ePEoKHyJy1J4V50Dir9JJHkkea9a8ACEZexpUxB5Dzj3I_HrfOF-sntCwLk39CkfFrRZzNrFS1sufliPn4Fwj');">
        </div>
        <div class="absolute inset-0 bg-primary/80 backdrop-blur-[2px]"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center px-12 text-center text-white">
            <div class="max-w-md">
                <h2 class="mb-6 text-5xl font-black leading-tight">Your Health, Our Priority</h2>
                <p class="mb-10 text-lg font-medium text-white/90">
                    Access real-time health insights, automated prescriptions, and dedicated support on the world's leading AI healthcare network.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <div class="flex items-center gap-2 rounded-full bg-white/20 px-4 py-2 backdrop-blur-md">
                        <span class="material-symbols-outlined text-teal-300">shield</span>
                        <span class="text-sm font-bold">HIPAA Compliant</span>
                    </div>
                    <div class="flex items-center gap-2 rounded-full bg-white/20 px-4 py-2 backdrop-blur-md">
                        <span class="material-symbols-outlined text-teal-300">group</span>
                        <span class="text-sm font-bold">10,000+ Active Users</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
</body>
</html>
