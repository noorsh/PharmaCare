@model PharmaCare.MVC.Models.ViewModels.PatientRegistrationViewModel
@{
ViewData["Title"] = "Patient Registration";
Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PharmaCare | Patient Registration</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#1392ec",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101a22",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>

    <style>
        body { font-family: 'Inter', sans-serif; }
        .form-input:focus { border-color: #1392ec; ring: 0; outline: 0; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#111518] dark:text-white transition-colors duration-200">
<div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">
    <div class="layout-container flex h-full grow flex-col">
        <!-- Top Navigation Bar -->
        <header class="sticky top-0 z-50 flex items-center justify-between whitespace-nowrap border-b border-solid border-[#dbe1e6] dark:border-slate-800 bg-white dark:bg-slate-900 px-4 md:px-10 py-3">
            <div class="flex items-center gap-4">
                <div class="size-8 text-primary">
                    <svg fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.57829 8.57829C5.52816 11.6284 3.451 15.5145 2.60947 19.7452C1.76794 23.9758 2.19984 28.361 3.85056 32.3462C5.50128 36.3314 8.29667 39.7376 11.8832 42.134C15.4698 44.5305 19.6865 45.8096 24 45.8096C28.3135 45.8096 32.5302 44.5305 36.1168 42.134C39.7033 39.7375 42.4987 36.3314 44.1494 32.3462C45.8002 28.361 46.2321 23.9758 45.3905 19.7452C44.549 15.5145 42.4718 11.6284 39.4217 8.57829L24 24L8.57829 8.57829Z" fill="currentColor"></path>
                    </svg>
                </div>
                <h2 class="text-[#111518] dark:text-white text-xl font-bold leading-tight">PharmaCare</h2>
            </div>
            <div class="flex gap-2">
                <a asp-action="Login" asp-controller="Account" class="flex min-w-[84px] cursor-pointer items-center justify-center rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold">
                    <span>Sign In</span>
                </a>
            </div>
        </header>

        <main class="flex flex-1 justify-center py-10 px-4">
            <div class="layout-content-container flex flex-col max-w-[900px] w-full gap-8">
                <!-- Header -->
                <div class="flex flex-col gap-2">
                    <h1 class="text-[#111518] dark:text-white text-4xl font-black tracking-tight">Patient Registration</h1>
                    <p class="text-[#617989] dark:text-slate-400 text-lg">Detailed clinical onboarding for personalized healthcare services.</p>
                </div>

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-red-500">error</span>
                        <div asp-validation-summary="All" class="text-sm text-red-700 dark:text-red-300"></div>
                    </div>
                </div>
                }

                <form asp-action="Register" asp-controller="Account" method="post" enctype="multipart/form-data" class="contents">
                    @Html.AntiForgeryToken()

                    <!-- 1. Account Information -->
                    <section class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-[#dbe1e6] dark:border-slate-800 p-6 md:p-8">
                        <div class="flex items-center gap-3 mb-6 border-b border-slate-100 dark:border-slate-800 pb-4">
                            <span class="material-symbols-outlined text-primary">person_add</span>
                            <h2 class="text-xl font-bold">1. Account Information</h2>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <label class="flex flex-col gap-2">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">First Name *</span>
                                <input asp-for="FirstName" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4 focus:ring-primary focus:border-primary" placeholder="John" type="text"/>
                                <span asp-validation-for="FirstName" class="text-xs text-red-500"></span>
                            </label>

                            <label class="flex flex-col gap-2">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Last Name *</span>
                                <input asp-for="LastName" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4" placeholder="Doe" type="text"/>
                                <span asp-validation-for="LastName" class="text-xs text-red-500"></span>
                            </label>

                            <label class="flex flex-col gap-2">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Email Address *</span>
                                <input asp-for="Email" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4" placeholder="john.doe@example.com" type="email" autocomplete="username"/>
                                <span asp-validation-for="Email" class="text-xs text-red-500"></span>
                            </label>

                            <label class="flex flex-col gap-2">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Phone Number *</span>
                                <input asp-for="PhoneNumber" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4" placeholder="+961 XX XXX XXX" type="tel"/>
                                <span asp-validation-for="PhoneNumber" class="text-xs text-red-500"></span>
                            </label>

                            <div class="flex flex-col gap-2 relative">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Password *</span>
                                <div class="relative">
                                    <input asp-for="Password" id="password" class="form-input w-full rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4 pr-10" type="password" autocomplete="new-password"/>
                                    <span class="material-symbols-outlined absolute right-3 top-3 text-slate-400 cursor-pointer" onclick="togglePasswordField('password', 'password-icon')">
                                            <span id="password-icon">visibility</span>
                                        </span>
                                </div>
                                <div class="flex gap-1 h-1.5 mt-1" id="strength-bar">
                                    <div class="flex-1 bg-slate-200 dark:bg-slate-700 rounded-full"></div>
                                    <div class="flex-1 bg-slate-200 dark:bg-slate-700 rounded-full"></div>
                                    <div class="flex-1 bg-slate-200 dark:bg-slate-700 rounded-full"></div>
                                </div>
                                <span class="text-[10px] text-slate-500 font-medium" id="strength-text">Enter password</span>
                                <span asp-validation-for="Password" class="text-xs text-red-500"></span>
                            </div>

                            <label class="flex flex-col gap-2">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Confirm Password *</span>
                                <div class="relative">
                                    <input asp-for="ConfirmPassword" id="confirmPassword" class="form-input w-full rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4 pr-10" type="password" autocomplete="new-password"/>
                                    <span class="material-symbols-outlined absolute right-3 top-3 text-slate-400" id="match-indicator"></span>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500"></span>
                            </label>
                        </div>
                    </section>

                    <!-- 2. Profile Photo -->
                    <section class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-[#dbe1e6] dark:border-slate-800 p-6 md:p-8">
                        <div class="flex items-center gap-3 mb-6 border-b border-slate-100 dark:border-slate-800 pb-4">
                            <span class="material-symbols-outlined text-primary">account_circle</span>
                            <h2 class="text-xl font-bold">2. Profile Photo <span class="text-red-500">*</span></h2>
                        </div>
                        <div class="flex items-center gap-6">
                            <!-- Preview circle -->
                            <div id="photoPreview"
                                 class="size-24 rounded-full bg-slate-100 dark:bg-slate-800 border-2 border-dashed border-slate-300 dark:border-slate-600 flex items-center justify-center overflow-hidden flex-shrink-0">
                                <span class="material-symbols-outlined text-slate-400 text-4xl">person</span>
                            </div>
                            <div class="flex-1">
                                <input asp-for="ProfilePhoto"
                                       type="file"
                                       id="profilePhotoInput"
                                       accept="image/jpeg,image/png,image/webp"
                                       class="hidden"
                                       onchange="previewPhoto(this)" />
                                <button type="button"
                                        onclick="document.getElementById('profilePhotoInput').click()"
                                        class="flex items-center gap-2 px-4 py-2.5 bg-primary/10 text-primary border border-primary/20 rounded-lg text-sm font-semibold hover:bg-primary/20 transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">upload</span>
                                    Upload Photo
                                </button>
                                <p class="text-xs text-slate-500 mt-2">JPG, PNG or WebP — max 5MB. Required.</p>
                                <span asp-validation-for="ProfilePhoto" class="text-xs text-red-500 mt-1 block"></span>
                            </div>
                        </div>
                    </section>

                    <!-- 3. Personal Information -->
                    <section class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-[#dbe1e6] dark:border-slate-800 p-6 md:p-8">
                        <div class="flex items-center gap-3 mb-6 border-b border-slate-100 dark:border-slate-800 pb-4">
                            <span class="material-symbols-outlined text-primary">contact_page</span>
                            <h2 class="text-xl font-bold">3. Personal Information</h2>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <label class="flex flex-col gap-2">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Date of Birth *</span>
                                <input asp-for="DateOfBirth" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4" type="date"/>
                                <span asp-validation-for="DateOfBirth" class="text-xs text-red-500"></span>
                                <span class="text-xs text-slate-500">Must be 18+ to register</span>
                            </label>

                            <label class="flex flex-col gap-2">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Gender *</span>
                                <select asp-for="Gender" class="form-select rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-xs text-red-500"></span>
                            </label>

                            <label class="flex flex-col gap-2 md:col-span-2">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Street Address</span>
                                <input asp-for="Address" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4" placeholder="123 Health Ave" type="text"/>
                                <span asp-validation-for="Address" class="text-xs text-red-500"></span>
                            </label>

                            <label class="flex flex-col gap-2">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">City</span>
                                <input asp-for="City" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4" placeholder="e.g., Beirut, Tripoli" type="text"/>
                                <span asp-validation-for="City" class="text-xs text-red-500"></span>
                            </label>

                            <label class="flex flex-col gap-2">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Emergency Contact Phone</span>
                                <input asp-for="EmergencyContact" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4" placeholder="+961 XX XXX XXX" type="tel"/>
                                <span asp-validation-for="EmergencyContact" class="text-xs text-red-500"></span>
                            </label>
                        </div>
                    </section>

                    <!-- 4. Safety Flags -->
                    <section class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-[#dbe1e6] dark:border-slate-800 p-6 md:p-8">
                        <div class="flex items-center gap-3 mb-4 border-b border-slate-100 dark:border-slate-800 pb-4">
                            <span class="material-symbols-outlined text-amber-500">warning</span>
                            <h2 class="text-xl font-bold">4. Critical Safety Flags</h2>
                        </div>

                        <div class="bg-amber-50 dark:bg-amber-900/20 border-l-4 border-amber-500 p-4 mb-6 flex items-start gap-3">
                            <span class="material-symbols-outlined text-amber-600 mt-0.5">info</span>
                            <p class="text-sm text-amber-800 dark:text-amber-200">
                                <strong>IMPORTANT:</strong> This information helps prevent dangerous drug interactions and ensures medication safety.
                            </p>
                        </div>

                        <div class="space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <label class="flex items-center gap-3 p-4 border border-slate-100 dark:border-slate-800 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/50 cursor-pointer">
                                    <input asp-for="HasKidneyDisease" class="size-5 rounded border-slate-300 text-primary focus:ring-primary" type="checkbox"/>
                                    <span class="text-sm font-medium">Kidney Disease / Impairment</span>
                                </label>

                                <label class="flex items-center gap-3 p-4 border border-slate-100 dark:border-slate-800 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/50 cursor-pointer">
                                    <input asp-for="HasLiverDisease" class="size-5 rounded border-slate-300 text-primary focus:ring-primary" type="checkbox"/>
                                    <span class="text-sm font-medium">Liver Disease / Hepatitis</span>
                                </label>

                                <label class="flex items-center gap-3 p-4 border-2 border-red-200 dark:border-red-900/50 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/10 cursor-pointer md:col-span-2">
                                    <input asp-for="HasDrugAllergies" id="hasDrugAllergies" class="size-5 rounded border-red-400 text-red-600 focus:ring-red-500" type="checkbox"/>
                                    <span class="text-sm font-bold text-red-700 dark:text-red-400 uppercase tracking-tight">Drug Allergies (Known)</span>
                                </label>
                            </div>

                            <div id="drugAllergyDetailsDiv" class="flex flex-col gap-2" style="display: none;">
                                <span class="text-sm font-semibold text-red-700 dark:text-red-400">Please list all drug allergies and reaction types *</span>
                                <textarea asp-for="DrugAllergyDetails" class="form-input rounded-lg border-red-500 bg-red-50/30 dark:bg-red-900/10 dark:border-red-800 p-4 focus:ring-red-500 focus:border-red-500" placeholder="e.g. Penicillin - Hives and difficulty breathing, Sulfa Drugs - Severe rash" rows="3"></textarea>
                                <span asp-validation-for="DrugAllergyDetails" class="text-xs text-red-500"></span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-slate-100 dark:border-slate-800">
                                <label class="flex items-center gap-3 p-4 bg-pink-50 dark:bg-pink-900/20 border border-pink-100 dark:border-pink-800 rounded-lg cursor-pointer">
                                    <input asp-for="IsPregnant" class="size-5 rounded border-pink-300 text-pink-600 focus:ring-pink-500" type="checkbox"/>
                                    <span class="text-sm font-bold text-pink-700 dark:text-pink-300 uppercase">Pregnant</span>
                                </label>

                                <label class="flex items-center gap-3 p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800 rounded-lg cursor-pointer">
                                    <input asp-for="IsBreastfeeding" class="size-5 rounded border-blue-300 text-primary focus:ring-primary" type="checkbox"/>
                                    <span class="text-sm font-bold text-blue-700 dark:text-blue-300 uppercase">Breastfeeding</span>
                                </label>
                            </div>
                        </div>
                    </section>

                    <!-- 5. Medical Profile (Optional) -->
                    <section class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-[#dbe1e6] dark:border-slate-800 p-6 md:p-8">
                        <div class="flex items-center gap-3 mb-6 border-b border-slate-100 dark:border-slate-800 pb-4">
                            <span class="material-symbols-outlined text-primary">monitor_heart</span>
                            <h2 class="text-xl font-bold">5. Medical Profile <span class="text-sm font-normal text-slate-500">(Optional)</span></h2>
                        </div>

                        <div class="space-y-8">
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                                <label class="flex flex-col gap-2">
                                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Height (cm)</span>
                                    <input asp-for="Height" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4" placeholder="175" type="number" step="0.1"/>
                                    <span asp-validation-for="Height" class="text-xs text-red-500"></span>
                                </label>

                                <label class="flex flex-col gap-2">
                                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Weight (kg)</span>
                                    <input asp-for="Weight" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4" placeholder="70" type="number" step="0.1"/>
                                    <span asp-validation-for="Weight" class="text-xs text-red-500"></span>
                                </label>

                                <label class="flex flex-col gap-2">
                                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Blood Type</span>
                                    <select asp-for="BloodType" asp-items="Html.GetEnumSelectList<PharmaCare.Data.Models.Enums.BloodType>()" class="form-select rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4">
                                        <option value="">Select</option>
                                    </select>
                                    <span asp-validation-for="BloodType" class="text-xs text-red-500"></span>
                                </label>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4">
                                <label class="flex flex-col gap-2">
                                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Smoking Status</span>
                                    <select asp-for="SmokingStatus" asp-items="Html.GetEnumSelectList<PharmaCare.Data.Models.Enums.SmokingStatus>()" class="form-select rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4">
                                        <option value="">Select</option>
                                    </select>
                                </label>

                                <label class="flex flex-col gap-2">
                                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Alcohol Intake</span>
                                    <select asp-for="AlcoholConsumption" asp-items="Html.GetEnumSelectList<PharmaCare.Data.Models.Enums.AlcoholConsumption>()" class="form-select rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4">
                                        <option value="">Select</option>
                                    </select>
                                </label>

                                <label class="flex flex-col gap-2">
                                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Exercise Level</span>
                                    <select asp-for="ExerciseFrequency" asp-items="Html.GetEnumSelectList<PharmaCare.Data.Models.Enums.ExerciseFrequency>()" class="form-select rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 h-12 px-4">
                                        <option value="">Select</option>
                                    </select>
                                </label>
                            </div>

                            <label class="flex flex-col gap-2 pt-4">
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Additional Medical Notes</span>
                                <textarea asp-for="AdditionalNotes" class="form-input rounded-lg border-[#dbe1e6] dark:border-slate-700 dark:bg-slate-800 p-4" placeholder="List any other chronic conditions, recent surgeries, or specific concerns..." rows="3"></textarea>
                                <span asp-validation-for="AdditionalNotes" class="text-xs text-red-500"></span>
                            </label>
                        </div>
                    </section>

                    <!-- 6. Terms & Compliance -->
                    <section class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-[#dbe1e6] dark:border-slate-800 p-6 md:p-8">
                        <div class="flex items-center gap-3 mb-6 border-b border-slate-100 dark:border-slate-800 pb-4">
                            <span class="material-symbols-outlined text-primary">gavel</span>
                            <h2 class="text-xl font-bold">6. Terms & Compliance</h2>
                        </div>
                        <div class="space-y-4">
                            <label class="flex items-start gap-4 p-2 cursor-pointer">
                                <input class="mt-1 size-5 rounded border-slate-300 text-primary focus:ring-primary" type="checkbox" required/>
                                <div class="flex flex-col">
                                    <span class="text-sm font-semibold">Terms of Service Agreement *</span>
                                    <span class="text-xs text-slate-500">I have read and agree to the <a href="#" class="text-primary hover:underline">Terms of Service</a> and <a href="#" class="text-primary hover:underline">Privacy Policy</a>.</span>
                                </div>
                            </label>

                            <label class="flex items-start gap-4 p-2 cursor-pointer">
                                <input class="mt-1 size-5 rounded border-slate-300 text-primary focus:ring-primary" type="checkbox" required/>
                                <div class="flex flex-col">
                                    <span class="text-sm font-semibold">HIPAA Privacy Practices *</span>
                                    <span class="text-xs text-slate-500">I acknowledge PharmaCare's HIPAA-compliant medical data privacy practices.</span>
                                </div>
                            </label>

                            <label class="flex items-start gap-4 p-2 cursor-pointer">
                                <input class="mt-1 size-5 rounded border-slate-300 text-primary focus:ring-primary" type="checkbox"/>
                                <div class="flex flex-col">
                                    <span class="text-sm font-semibold">Marketing Preferences (Optional)</span>
                                    <span class="text-xs text-slate-500">I consent to receive health tips and wellness newsletters via email.</span>
                                </div>
                            </label>
                        </div>
                    </section>

                    <!-- Action Button -->
                    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-20">
                        <div class="flex items-center gap-2 text-slate-500 text-sm italic">
                            <span class="material-symbols-outlined text-green-500">lock</span>
                            Secure 256-bit encrypted submission
                        </div>
                        <button type="submit" class="w-full md:w-auto min-w-[280px] flex items-center justify-center gap-2 rounded-xl h-14 px-8 bg-primary text-white text-lg font-bold shadow-lg shadow-blue-200 dark:shadow-none hover:bg-blue-600 transition-all active:scale-95">
                            Complete Registration
                            <span class="material-symbols-outlined">chevron_right</span>
