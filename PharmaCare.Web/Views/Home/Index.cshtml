@{
ViewData["Title"] = "Home";
Layout = "_LandingLayout";
}

<!-- Top Navigation Bar -->
<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 flex h-16 items-center justify-between">
        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2">
            <div class="text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl">health_metrics</span>
            </div>
            <h1 class="text-xl font-bold tracking-tight text-[#111518]">PharmaCare</h1>
        </a>
        <nav class="hidden md:flex items-center gap-8">
            <a href="#patients" class="text-sm font-medium text-gray-600 hover:text-primary transition-colors">For Patients</a>
            <a href="#pharmacists" class="text-sm font-medium text-gray-600 hover:text-primary transition-colors">For Pharmacists</a>
            <a href="#about" class="text-sm font-medium text-gray-600 hover:text-primary transition-colors">About Us</a>
        </nav>
        <div class="flex items-center gap-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
            <a asp-controller="Patient" asp-action="Dashboard" class="bg-primary hover:bg-primary/90 text-white px-5 py-2 rounded-lg text-sm font-bold shadow-md transition-all active:scale-95">
                Dashboard
            </a>
            }
            else
            {
            <a asp-controller="Account" asp-action="Login" class="text-sm font-semibold text-gray-700 hover:text-primary transition-colors">
                Log in
            </a>
            <a asp-controller="Account" asp-action="Register" class="bg-primary hover:bg-primary/90 text-white px-5 py-2 rounded-lg text-sm font-bold shadow-md transition-all active:scale-95">
                Sign Up
            </a>
            }
        </div>
    </div>
</header>

<main>
    <!-- Hero Section -->
    <section class="relative overflow-hidden py-16 lg:py-24">
        <div class="max-w-7xl mx-auto px-6 lg:px-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="flex flex-col gap-8">
                <div class="inline-flex items-center gap-2 bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider w-fit">
                    <span class="material-symbols-outlined text-sm">bolt</span>
                    AI-Powered Health Solutions
                </div>
                <div class="flex flex-col gap-4">
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-tight text-[#111518]">
                        Your Health, <span class="text-primary">Empowered by AI</span>
                    </h1>
                    <p class="text-lg text-gray-600 max-w-lg leading-relaxed">
                        Navigating healthcare in Lebanon made simple. Connect with trusted pharmacists and manage your wellness with our AI-driven platform tailored for your local needs.
                    </p>
                </div>
                <div class="flex flex-wrap gap-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                    <a asp-controller="Consultation" asp-action="Start" class="bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-xl text-base font-bold shadow-lg shadow-primary/20 transition-all flex items-center gap-2">
                        Start Consultation
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </a>
                    <a asp-controller="Patient" asp-action="Profile" class="bg-secondary-teal hover:bg-secondary-teal/90 text-white px-8 py-4 rounded-xl text-base font-bold shadow-lg shadow-teal-500/20 transition-all">
                        View Profile
                    </a>
                    }
                    else
                    {
                    <a asp-controller="Account" asp-action="Register" class="bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-xl text-base font-bold shadow-lg shadow-primary/20 transition-all flex items-center gap-2">
                        Register as Patient
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </a>
                    <a asp-controller="Account" asp-action="Register" asp-route-role="Pharmacist" class="bg-secondary-teal hover:bg-secondary-teal/90 text-white px-8 py-4 rounded-xl text-base font-bold shadow-lg shadow-teal-500/20 transition-all">
                        Join as Pharmacist
                    </a>
                    }
                </div>
                <div class="flex items-center gap-4 text-sm text-gray-500">
                    <div class="flex -space-x-2">
                        <img alt="Pharmacist" class="w-8 h-8 rounded-full border-2 border-white" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCedoJxCrbbjJKFLmIwWycaVwlRH6XOBJwWOV26l6UzSjQMIXUAnGvuTzyG4l-t6R4xEoH2rS6RPsIfK-1XWi7pc9MsIlYdg6Ui-G07e_1BpjuQO-RrNRLxIwSShoMscOsJ8oxekQKVTFFCSP5xC_PjrLLdN9pmwjVuAoLQ7_S3yL6M_NODN0eePs0JoojFFoYPKsoKmLBJwuSF_ls-tQ5Bq-ZY6VfWzA65hkZJbCw4bjQ1P5q_ONJwacllnlkxxp-xVFb7ANmtGw"/>
                        <img alt="Medical Professional" class="w-8 h-8 rounded-full border-2 border-white" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCd-SY6Zg-k867RY39AC33docIGEDO_o85T-ll5OSkFfiGlThZGkRuIar5ypiqCd0KXzEOxmWEyoxIuNbXGCWPjpTfc2bqxOeXZLl4XQ5VmlH0DfQ27f07GpYCDBXERH1rJxnF8sglzDXtstPq0HmC7KDfRN3hQAgXJLsaZO2v_kflCuszxZZqJiqeUAhlvaiuism5VJMLEVg_roUcctrf4g2J3Hdk9WAk9Nx4Kbdd6EeAeb38BI368LiJHp0SRzyM86r4Vq-U6JQ"/>
                        <img alt="Happy Patient" class="w-8 h-8 rounded-full border-2 border-white" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDjlECkK95np9cdLJxi4pYHE1NlwyAzQkG-1EpnAjfPNhD5KSmy5kYEHkhgmgjMtd2SL5AEtZRPjoj5JKxlbvrOgB8jN_EAdSX4XULzu5MkUkRxK_8wsbwQ5sCBGdE2UKVS7OyJ43CbuauT5phZZOJfUZVuXtRfOH3gNUCJdGhMzDASsDPTtzIspp36SyO56YMpArSrllm8eRxjKhv-0J7WIDVIGObrfhZUbarhX_LlpJj09vCe74zfb2CjEacFP9ZE0rbd4yFqhA"/>
                    </div>
                    <p>Trusted by over <span class="font-bold text-gray-900">10,000+</span> users in Lebanon</p>
                </div>
            </div>
            <div class="relative">
                <div class="absolute inset-0 bg-primary/5 rounded-3xl -rotate-2 scale-105"></div>
                <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-gray-100">
                    <div class="aspect-video bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCtpjNRkWc6Uk1XkJqyeSKCsHg7CoFpDCLUZzDN_NmdI2nsXyECV07cNWc8ZkxZx_t7WcLUetjZLvbMwW92kFKjct3uGrOfxgvXhQS9hKSHhFN6C8agh0SlQIrGdVTvlIEdwhhKJMW0hPW6JSvcpPUr-FONqX74XFCdNozek_ugsH18x_S4mhyOh1k5PzF1MT5AwVoSsxHjKyNt2H7BNfpX_BHhVo90LuSobmtggzPoO3wL2C8L2si_4DxiOf5K-Emc6JGmEG1eXQ')"></div>
                    <div class="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur p-4 rounded-xl flex items-center gap-4">
                        <div class="p-2 bg-primary/10 rounded-lg">
                            <span class="material-symbols-outlined text-primary">verified_user</span>
                        </div>
                        <div>
                            <p class="text-xs font-bold uppercase text-gray-500">Security Status</p>
                            <p class="text-sm font-semibold text-gray-900">100% Encrypted Medical Records</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Value Proposition Section -->
    <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="text-center max-w-3xl mx-auto mb-16 flex flex-col gap-4">
                <h2 class="text-3xl md:text-4xl font-bold text-[#111518]">Why Choose PharmaCare</h2>
                <p class="text-gray-600">Experience the future of healthcare with our innovative solutions designed for reliability, speed, and intelligence.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Reliability Card -->
                <div class="group p-8 rounded-2xl bg-background-light border border-gray-100 hover:border-primary/30 transition-all hover:shadow-xl hover:shadow-primary/5">
                    <div class="size-14 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-3xl">verified</span>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-[#111518]">Reliability</h3>
                    <p class="text-gray-600 leading-relaxed">
                        Verified pharmacies and authentic medications for your peace of mind. Every partner pharmacy is strictly vetted for quality assurance.
                    </p>
                </div>

                <!-- Accessibility Card -->
                <div class="group p-8 rounded-2xl bg-background-light border border-gray-100 hover:border-primary/30 transition-all hover:shadow-xl hover:shadow-primary/5">
                    <div class="size-14 bg-secondary-teal/10 text-secondary-teal rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-3xl">location_on</span>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-[#111518]">Accessibility</h3>
                    <p class="text-gray-600 leading-relaxed">
                        24/7 access to health resources across all Lebanese regions. Find the nearest open pharmacy even in the middle of the night.
                    </p>
                </div>

                <!-- AI-Driven Care Card -->
                <div class="group p-8 rounded-2xl bg-background-light border border-gray-100 hover:border-primary/30 transition-all hover:shadow-xl hover:shadow-primary/5">
                    <div class="size-14 bg-purple-500/10 text-purple-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-3xl">psychology</span>
                    </div>
                    <h3 class="text-xl font-bold mb-3 text-[#111518]">AI-Driven Care</h3>
                    <p class="text-gray-600 leading-relaxed">
                        Smart reminders and health insights tailored specifically for your needs. Predictive analytics help you manage prescriptions effortlessly.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action Banner -->
    <section class="py-20">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
            <div class="relative bg-primary rounded-[2.5rem] overflow-hidden px-8 py-16 text-center text-white">
                <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"></div>
                <div class="relative z-10 flex flex-col items-center gap-8">
                    <h2 class="text-3xl md:text-5xl font-black max-w-2xl leading-tight">Ready to take control of your health?</h2>
                    <p class="text-lg opacity-90 max-w-xl">Join thousands of patients and pharmacists already using PharmaCare to transform healthcare in Lebanon.</p>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                    <a asp-controller="Consultation" asp-action="Start" class="bg-white text-primary px-10 py-4 rounded-xl text-lg font-bold hover:bg-gray-100 transition-colors shadow-xl">
                        Start Consultation Now
                    </a>
                    }
                    else
                    {
                    <a asp-controller="Account" asp-action="Register" class="bg-white text-primary px-10 py-4 rounded-xl text-lg font-bold hover:bg-gray-100 transition-colors shadow-xl">
                        Get Started Now
                    </a>
                    }
                </div>
            </div>
        </div>
    </section>
</main>

<!-- Footer -->
<footer class="bg-white border-t border-gray-200 py-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
            <div class="col-span-1 md:col-span-1">
                <div class="flex items-center gap-2 mb-6">
                    <div class="text-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-3xl font-bold">health_metrics</span>
                    </div>
                    <h1 class="text-xl font-bold tracking-tight text-[#111518]">PharmaCare</h1>
                </div>
                <p class="text-sm text-gray-500 leading-relaxed">
                    Leading the digital healthcare revolution in Lebanon with patient-centered AI technology.
                </p>
            </div>
            <div>
                <h4 class="font-bold mb-6 text-[#111518]">Platform</h4>
                <ul class="space-y-4 text-sm text-gray-600">
                    <li><a asp-controller="Account" asp-action="Register" class="hover:text-primary transition-colors">Find a Pharmacy</a></li>
                    <li><a asp-controller="Consultation" asp-action="Start" class="hover:text-primary transition-colors">AI Health Assistant</a></li>
                    <li><a asp-controller="Patient" asp-action="CurrentMedications" class="hover:text-primary transition-colors">Prescription Tracking</a></li>
                    <li><a href="#" class="hover:text-primary transition-colors">Mobile App</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-6 text-[#111518]">Company</h4>
                <ul class="space-y-4 text-sm text-gray-600">
                    <li><a href="#about" class="hover:text-primary transition-colors">About Us</a></li>
                    <li><a href="#" class="hover:text-primary transition-colors">Our Team</a></li>
                    <li><a href="#" class="hover:text-primary transition-colors">Contact Support</a></li>
                    <li><a href="#" class="hover:text-primary transition-colors">Careers</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-6 text-[#111518]">Connect</h4>
                <div class="flex gap-4 mb-6">
                    <a class="size-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-primary hover:text-white transition-all" href="#">
                        <svg class="size-5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                    <a class="size-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-primary hover:text-white transition-all" href="#">
                        <svg class="size-5 fill-current" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.84 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                    </a>
                    <a class="size-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-primary hover:text-white transition-all" href="#">
                        <svg class="size-5 fill-current" viewBox="0 0 24 24"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.132 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zM12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </a>
                </div>
                <p class="text-sm font-medium text-gray-900 mb-2">Subscribe to our newsletter</p>
                <div class="flex gap-2">
                    <input class="bg-gray-100 border-none rounded-lg px-4 py-2 text-sm focus:ring-primary w-full" placeholder="Email address" type="email"/>
                    <button class="bg-primary text-white p-2 rounded-lg hover:bg-primary/90 transition-colors">
                        <span class="material-symbols-outlined text-sm">send</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="pt-12 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="text-sm text-gray-500">© 2025 PharmaCare Lebanon. All rights reserved.</p>
            <div class="flex gap-8">
                <a class="text-sm text-gray-500 hover:text-primary transition-colors" href="#">Privacy Policy</a>
                <a class="text-sm text-gray-500 hover:text-primary transition-colors" href="#">Terms of Service</a>
                <a class="text-sm text-gray-500 hover:text-primary transition-colors" href="#">Cookies Settings</a>
            </div>
        </div>
    </div>
</footer>