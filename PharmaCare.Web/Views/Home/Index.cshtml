@{
    ViewData["Title"] = "Home";
    Layout = "_LandingLayout";
}

@* ── NAVIGATION ───────────────────────────────────── *@
<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 flex h-16 items-center justify-between">

        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2">
            <span class="material-symbols-outlined text-3xl text-primary" style="font-variation-settings:'FILL' 1;">health_metrics</span>
            <span class="text-xl font-black tracking-tight text-[#111518]" style="font-family:'Manrope',sans-serif;">PharmaCare</span>
        </a>

        <div class="hidden md:flex items-center gap-8">
            <a href="#how-it-works" class="text-sm font-medium text-gray-600 hover:text-primary transition-colors">How It Works</a>
            <a href="#features"     class="text-sm font-medium text-gray-600 hover:text-primary transition-colors">Why Us</a>
            <a href="#testimonials"  class="text-sm font-medium text-gray-600 hover:text-primary transition-colors">Reviews</a>
        </div>

        <div class="flex items-center gap-3">
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Patient"))
            {
                <a asp-controller="Patient" asp-action="Dashboard"
                   class="bg-primary hover:bg-primary-dark text-white px-5 py-2 rounded-lg text-sm font-bold shadow-md transition-all active:scale-95">
                    Dashboard
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="px-5 py-2 rounded-lg text-sm font-semibold text-gray-600 hover:text-primary border border-gray-200 hover:border-primary transition-all">
                        Logout
                    </button>
                </form>
            }
            else if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Dashboard"
                   class="bg-primary hover:bg-primary-dark text-white px-5 py-2 rounded-lg text-sm font-bold shadow-md transition-all active:scale-95">
                    Dashboard
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="px-5 py-2 rounded-lg text-sm font-semibold text-gray-600 hover:text-primary border border-gray-200 hover:border-primary transition-all">
                        Logout
                    </button>
                </form>
            }
            else if (User.Identity?.IsAuthenticated == true && User.IsInRole("Pharmacist"))
            {
                <a asp-controller="Pharmacist" asp-action="Dashboard"
                   class="bg-primary hover:bg-primary-dark text-white px-5 py-2 rounded-lg text-sm font-bold shadow-md transition-all active:scale-95">
                    Dashboard
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="px-5 py-2 rounded-lg text-sm font-semibold text-gray-600 hover:text-primary border border-gray-200 hover:border-primary transition-all">
                        Logout
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login"
                   class="text-sm font-semibold text-gray-600 hover:text-primary transition-colors">
                    Log in
                </a>
                <a asp-controller="Account" asp-action="Register"
                   class="bg-primary hover:bg-primary-dark text-white px-5 py-2 rounded-lg text-sm font-bold shadow-md transition-all active:scale-95">
                    Get Started Free
                </a>
            }
        </div>

    </div>
</header>

<main>

@* ── HERO ─────────────────────────────────────────── *@
<section class="relative overflow-hidden py-16 lg:py-28 bg-white">

    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] bg-blue-50 rounded-full pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-[300px] h-[300px] bg-teal-50 rounded-full pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-10 grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">

        <div class="flex flex-col gap-8">

            <span class="inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider w-fit">
                <span class="material-symbols-outlined text-sm" style="font-variation-settings:'FILL' 1;">bolt</span>
                AI-Powered &middot; Pharmacist-Verified
            </span>

            <div class="flex flex-col gap-5">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-[1.1] tracking-tight text-[#111518]"
                    style="font-family:'Manrope',sans-serif;">
                    Describe your symptoms.<br>
                    <span class="text-primary">Get expert advice fast.</span>
                </h1>
                <p class="text-lg text-gray-600 max-w-lg leading-relaxed">
                    Tell us how you're feeling. Our AI analyzes your symptoms instantly, then a licensed pharmacist reviews and sends you a trusted recommendation — no waiting room, no guesswork.
                </p>
            </div>

            <div class="flex flex-wrap gap-4">
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Patient"))
                {
                    <a asp-controller="Consultation" asp-action="Start"
                       class="bg-primary hover:bg-primary-dark text-white px-8 py-4 rounded-xl text-base font-bold shadow-lg transition-all flex items-center gap-2 active:scale-95">
                        Start a Consultation
                        <span class="material-symbols-outlined text-lg">arrow_forward</span>
                    </a>
                    <a asp-controller="Patient" asp-action="Profile"
                       class="px-8 py-4 rounded-xl text-base font-bold border border-gray-200 text-gray-700 hover:border-primary hover:text-primary transition-all">
                        My Profile
                    </a>
                }
                else if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Pharmacist")))
                {
                    @* Dashboard link is in the nav bar for these roles *@
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register"
                       class="bg-primary hover:bg-primary-dark text-white px-8 py-4 rounded-xl text-base font-bold shadow-lg transition-all flex items-center gap-2 active:scale-95">
                        Start a Free Consultation
                        <span class="material-symbols-outlined text-lg">arrow_forward</span>
                    </a>
                    <a href="#how-it-works"
                       class="px-8 py-4 rounded-xl text-base font-bold border border-gray-200 text-gray-700 hover:border-primary hover:text-primary transition-all">
                        See How It Works
                    </a>
                }
            </div>

            <div class="flex flex-wrap gap-6 pt-2">
                <div class="flex items-center gap-2 text-sm text-gray-500">
                    <span class="material-symbols-outlined text-green-500 text-base" style="font-variation-settings:'FILL' 1;">check_circle</span>
                    Free to sign up
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-500">
                    <span class="material-symbols-outlined text-green-500 text-base" style="font-variation-settings:'FILL' 1;">check_circle</span>
                    Response in minutes
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-500">
                    <span class="material-symbols-outlined text-green-500 text-base" style="font-variation-settings:'FILL' 1;">check_circle</span>
                    100% encrypted &amp; private
                </div>
            </div>

        </div>

        @* Consultation Preview Card *@
        <div class="relative">
            <div class="absolute inset-0 bg-primary/5 rounded-3xl -rotate-1 scale-105 pointer-events-none"></div>
            <div class="relative rounded-3xl bg-white shadow-xl border border-gray-100 overflow-hidden">

                <div class="bg-primary px-6 py-4 flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-base" style="font-variation-settings:'FILL' 1;">health_metrics</span>
                    </div>
                    <span class="font-black text-white text-sm" style="font-family:'Manrope',sans-serif;">New Consultation</span>
                    <span class="ml-auto flex items-center gap-1.5 text-white/80 text-xs font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-400 inline-block animate-pulse"></span>
                        Pharmacist online
                    </span>
                </div>

                <div class="p-6 space-y-4">

                    <div>
                        <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">You mentioned</p>
                        <div class="flex flex-wrap gap-2">
                            <span class="px-3 py-1.5 bg-blue-50 text-primary text-sm font-semibold rounded-full border border-blue-100">Headache</span>
                            <span class="px-3 py-1.5 bg-blue-50 text-primary text-sm font-semibold rounded-full border border-blue-100">Fatigue</span>
                            <span class="px-3 py-1.5 bg-blue-50 text-primary text-sm font-semibold rounded-full border border-blue-100">Mild fever</span>
                            <span class="px-3 py-1.5 bg-gray-100 text-gray-500 text-sm font-medium rounded-full border border-gray-200">+ Add more</span>
                        </div>
                    </div>

                    <div class="bg-blue-50 rounded-xl p-4 border border-blue-100">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
                                <span class="material-symbols-outlined text-primary text-base">psychology</span>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-primary uppercase tracking-wider mb-1">AI Assessment</p>
                                <p class="text-sm text-gray-700 leading-relaxed">Based on your symptoms, this may be a tension headache or early-stage viral infection. Flagging for pharmacist review now.</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-green-50 rounded-xl p-4 border border-green-100">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center shrink-0 mt-0.5">
                                <span class="material-symbols-outlined text-green-700 text-base" style="font-variation-settings:'FILL' 1;">verified_user</span>
                            </div>
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <p class="text-xs font-bold text-green-700 uppercase tracking-wider">Pharmacist Rania</p>
                                    <span class="text-xs text-gray-400">&middot; just now</span>
                                </div>
                                <p class="text-sm text-gray-700 leading-relaxed">Confirmed. I recommend Paracetamol 500mg and rest. Drink plenty of fluids. If fever exceeds 39&deg;C, visit a clinic.</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-2 pt-1">
                        <button class="flex-1 bg-primary text-white py-2.5 rounded-xl text-sm font-bold hover:bg-primary-dark transition-all">
                            View Full Recommendation
                        </button>
                        <button class="px-4 py-2.5 rounded-xl border border-gray-200 text-gray-500 hover:border-gray-300 transition-all">
                            <span class="material-symbols-outlined text-base">save</span>
                        </button>
                    </div>

                </div>
            </div>
        </div>

    </div>
</section>

@* ── STATS BAR ────────────────────────────────────── *@
<section class="w-full bg-primary text-white py-10">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 grid grid-cols-2 md:grid-cols-4 gap-8">

        <div class="flex flex-col items-center md:items-start gap-1 text-center md:text-left">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined opacity-80">group</span>
                <span class="text-3xl font-black">10K+</span>
            </div>
            <p class="text-xs font-semibold uppercase tracking-widest opacity-70">Patients Helped</p>
        </div>

        <div class="flex flex-col items-center md:items-start gap-1 text-center md:text-left">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined opacity-80">timer</span>
                <span class="text-3xl font-black">&lt;5 min</span>
            </div>
            <p class="text-xs font-semibold uppercase tracking-widest opacity-70">Avg. Response Time</p>
        </div>

        <div class="flex flex-col items-center md:items-start gap-1 text-center md:text-left">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined opacity-80">psychology</span>
                <span class="text-3xl font-black">24/7</span>
            </div>
            <p class="text-xs font-semibold uppercase tracking-widest opacity-70">Always Available</p>
        </div>

        <div class="flex flex-col items-center md:items-start gap-1 text-center md:text-left">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined opacity-80">verified_user</span>
                <span class="text-3xl font-black">100%</span>
            </div>
            <p class="text-xs font-semibold uppercase tracking-widest opacity-70">Pharmacist-Verified</p>
        </div>

    </div>
</section>

@* ── HOW IT WORKS ─────────────────────────────────── *@
<section id="how-it-works" class="py-24 bg-background-light">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-black text-[#111518] mb-4" style="font-family:'Manrope',sans-serif;">
                How It Works
            </h2>
            <p class="text-gray-600 text-lg max-w-xl mx-auto">
                Getting expert pharmacy advice has never been this easy.
            </p>
        </div>

        <div class="flex flex-col md:flex-row items-start gap-10 md:gap-4">

            <div class="flex-1 flex flex-col items-center text-center px-4 relative">
                <div class="w-20 h-20 rounded-full bg-primary/10 border-2 border-primary/20 flex items-center justify-center mb-5 z-10">
                    <span class="material-symbols-outlined text-primary text-3xl">chat</span>
                </div>
                <span class="text-xs font-black uppercase tracking-widest text-primary mb-1">Step 1</span>
                <h4 class="font-bold text-lg text-[#111518] mb-2" style="font-family:'Manrope',sans-serif;">Tell us your symptoms</h4>
                <p class="text-sm text-gray-500 leading-relaxed">Type or select how you're feeling. No medical jargon needed — just describe it in your own words.</p>
                <div class="hidden md:block absolute top-10 left-[65%] w-[70%] h-[2px] bg-gray-200"></div>
            </div>

            <div class="flex-1 flex flex-col items-center text-center px-4 relative">
                <div class="w-20 h-20 rounded-full bg-teal-500/10 border-2 border-teal-500/20 flex items-center justify-center mb-5 z-10">
                    <span class="material-symbols-outlined text-secondary-teal text-3xl">psychology</span>
                </div>
                <span class="text-xs font-black uppercase tracking-widest text-secondary-teal mb-1">Step 2</span>
                <h4 class="font-bold text-lg text-[#111518] mb-2" style="font-family:'Manrope',sans-serif;">AI + Pharmacist review</h4>
                <p class="text-sm text-gray-500 leading-relaxed">Our AI pre-analyzes your case. A real licensed pharmacist then reviews it and prepares your recommendation.</p>
                <div class="hidden md:block absolute top-10 left-[65%] w-[70%] h-[2px] bg-gray-200"></div>
            </div>

            <div class="flex-1 flex flex-col items-center text-center px-4">
                <div class="w-20 h-20 rounded-full bg-green-500/10 border-2 border-green-500/20 flex items-center justify-center mb-5">
                    <span class="material-symbols-outlined text-green-600 text-3xl">medication</span>
                </div>
                <span class="text-xs font-black uppercase tracking-widest text-green-600 mb-1">Step 3</span>
                <h4 class="font-bold text-lg text-[#111518] mb-2" style="font-family:'Manrope',sans-serif;">Receive your recommendation</h4>
                <p class="text-sm text-gray-500 leading-relaxed">Get clear, trusted advice on your phone — what to take, how much, and when to see a doctor if needed.</p>
            </div>

        </div>
    </div>
</section>

@* ── WHY US ───────────────────────────────────────── *@
<section id="features" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl md:text-4xl font-black text-[#111518] mb-4" style="font-family:'Manrope',sans-serif;">
                Why patients trust PharmaCare
            </h2>
            <p class="text-gray-600 text-lg">Built around your needs — not the pharmacy's.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

            <div class="group p-8 rounded-2xl bg-gray-50 border border-gray-100 hover:border-primary/30 hover:shadow-xl transition-all duration-300">
                <div class="w-14 h-14 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
                    <span class="material-symbols-outlined text-3xl">verified</span>
                </div>
                <h3 class="text-xl font-bold mb-3 text-[#111518]" style="font-family:'Manrope',sans-serif;">Pharmacist-verified, always</h3>
                <p class="text-gray-600 leading-relaxed">
                    Every recommendation is reviewed by a licensed pharmacist before it reaches you. No AI hallucinations, no guesswork — just trusted advice.
                </p>
            </div>

            <div class="group p-8 rounded-2xl bg-gray-50 border border-gray-100 hover:border-primary/30 hover:shadow-xl transition-all duration-300">
                <div class="w-14 h-14 bg-teal-500/10 text-secondary-teal rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
                    <span class="material-symbols-outlined text-3xl">lock</span>
                </div>
                <h3 class="text-xl font-bold mb-3 text-[#111518]" style="font-family:'Manrope',sans-serif;">Your data stays private</h3>
                <p class="text-gray-600 leading-relaxed">
                    All your health records and conversations are fully encrypted. We never share your data with third parties — ever.
                </p>
            </div>

            <div class="group p-8 rounded-2xl bg-gray-50 border border-gray-100 hover:border-primary/30 hover:shadow-xl transition-all duration-300">
                <div class="w-14 h-14 bg-purple-500/10 text-purple-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
                    <span class="material-symbols-outlined text-3xl">location_on</span>
                </div>
                <h3 class="text-xl font-bold mb-3 text-[#111518]" style="font-family:'Manrope',sans-serif;">Built for Lebanon</h3>
                <p class="text-gray-600 leading-relaxed">
                    Designed around Lebanon's healthcare reality — available in your region, 24/7, even when local pharmacies are closed or inaccessible.
                </p>
            </div>

        </div>
    </div>
</section>

@* ── TESTIMONIALS ─────────────────────────────────── *@
<section id="testimonials" class="py-24 bg-background-light">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-black text-[#111518] mb-4" style="font-family:'Manrope',sans-serif;">
                What patients say
            </h2>
            <p class="text-gray-600 text-lg">Real people. Real results.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">

            <div class="p-8 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 border-l-4 border-l-primary">
                <div class="flex gap-0.5 mb-4 text-yellow-400" style="font-size:16px;">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                <p class="text-gray-600 italic leading-relaxed mb-6">
                    "I described my daughter's symptoms at midnight and had a pharmacist's recommendation within 4 minutes. Absolute lifesaver."
                </p>
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-full bg-blue-100 flex items-center justify-center font-black text-primary text-sm">SJ</div>
                    <div>
                        <p class="font-bold text-sm text-[#111518]">Sarah J.</p>
                        <p class="text-xs text-gray-400">Beirut &middot; Patient</p>
                    </div>
                </div>
            </div>

            <div class="p-8 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 border-l-4 border-l-secondary-teal">
                <div class="flex gap-0.5 mb-4 text-yellow-400" style="font-size:16px;">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                <p class="text-gray-600 italic leading-relaxed mb-6">
                    "I was worried it was just a chatbot. But a real pharmacist reviewed everything. I felt genuinely cared for, not just processed."
                </p>
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-full bg-teal-100 flex items-center justify-center font-black text-secondary-teal text-sm">KH</div>
                    <div>
                        <p class="font-bold text-sm text-[#111518]">Karim H.</p>
                        <p class="text-xs text-gray-400">Tripoli &middot; Patient</p>
                    </div>
                </div>
            </div>

            <div class="p-8 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 border-l-4 border-l-purple-500">
                <div class="flex gap-0.5 mb-4 text-yellow-400" style="font-size:16px;">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                <p class="text-gray-600 italic leading-relaxed mb-6">
                    "After the third pharmacy in my area closed, PharmaCare became the only reliable health resource I have. I use it every time now."
                </p>
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-full bg-purple-100 flex items-center justify-center font-black text-purple-700 text-sm">NM</div>
                    <div>
                        <p class="font-bold text-sm text-[#111518]">Nadia M.</p>
                        <p class="text-xs text-gray-400">Sidon &middot; Patient</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@* ── CTA BANNER ───────────────────────────────────── *@
<section class="py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="relative bg-primary rounded-[2.5rem] overflow-hidden px-8 py-20 text-center text-white">

            <div class="absolute inset-0 opacity-10"
                 style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-white/5 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col items-center gap-8">
                <h2 class="text-3xl md:text-5xl font-black max-w-2xl leading-tight" style="font-family:'Manrope',sans-serif;">
                    Not feeling well?<br>Talk to a pharmacist now.
                </h2>
                <p class="text-lg opacity-90 max-w-xl">
                    Get a trusted recommendation in minutes — free, private, and available across Lebanon 24/7.
                </p>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Consultation" asp-action="Start"
                       class="bg-white text-primary px-10 py-4 rounded-xl text-lg font-bold hover:bg-gray-100 transition-colors shadow-xl active:scale-95">
                        Start a Consultation Now
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register"
                       class="bg-white text-primary px-10 py-4 rounded-xl text-lg font-bold hover:bg-gray-100 transition-colors shadow-xl active:scale-95">
                        Start a Free Consultation
                    </a>
                }

                <p class="text-white/60 text-sm">No appointment needed &middot; No waiting room &middot; No cost to sign up</p>
            </div>

        </div>
    </div>
</section>

</main>

@* ── FOOTER ───────────────────────────────────────── *@
<footer class="bg-white border-t border-gray-100 py-12">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 flex flex-col md:flex-row justify-between items-center gap-6">

        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary" style="font-variation-settings:'FILL' 1;">health_metrics</span>
