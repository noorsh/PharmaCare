@model PharmaCare.Data.Models.CurrentMedication
@{
    ViewData["Title"] = "Delete Medication";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">
        <span class="text-muted fw-light">Profile / Medications /</span> Delete Medication
    </h4>

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-trash"></i> Confirm Deletion</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> 
                        <strong>Warning:</strong> Are you sure you want to delete this medication record?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Medication</dt>
                        <dd class="col-sm-8"><strong>@Model.MedicationName</strong></dd>

                        @if (!string.IsNullOrEmpty(Model.Dosage))
                        {
                            <dt class="col-sm-4">Dosage</dt>
                            <dd class="col-sm-8">@Model.Dosage</dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.Frequency))
                        {
                            <dt class="col-sm-4">Frequency</dt>
                            <dd class="col-sm-8">@Model.Frequency</dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.Purpose))
                        {
                            <dt class="col-sm-4">Purpose</dt>
                            <dd class="col-sm-8">@Model.Purpose</dd>
                        }

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>
                    </dl>

                    <hr class="my-4">

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="CurrentMedicationId" />
                        <div class="d-flex justify-content-between">
                            <a asp-controller="Patient" asp-action="Profile" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Yes, Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>