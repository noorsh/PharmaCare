@model PharmaCare.MVC.Models.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Custom Report Builder";
    Layout = "_LayoutAuth";
}

@* ── Page Header ─────────────────────────────────────────────────────────── *@
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
        <div class="flex items-center gap-3 mb-1">
            <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-primary/10">
                <span class="material-symbols-outlined text-primary">analytics</span>
            </div>
            <h2 class="text-2xl font-black tracking-tight">Custom Report Builder</h2>
        </div>
        <p class="text-[#617789] text-sm mt-1">Generate, filter, and export reports across the platform.</p>
    </div>
    <a asp-action="Dashboard" asp-controller="Admin"
       class="inline-flex items-center gap-2 text-sm font-semibold text-[#617789] hover:text-primary transition-colors">
        <span class="material-symbols-outlined text-base">arrow_back</span>
        Back to Dashboard
    </a>
</div>

@* ── Filter Bar ───────────────────────────────────────────────────────────── *@
<div class="rounded-xl border border-[#dbe1e6] bg-white shadow-sm p-6 mb-8">
    <form method="get" asp-action="Reports" asp-controller="Admin" class="flex flex-wrap items-end gap-4">

        @* Report Type *@
        <div class="flex flex-col gap-1.5 min-w-[180px]">
            <label class="text-xs font-bold uppercase tracking-wider text-[#617789]">Report Type</label>
            <select name="reportType" onchange="this.form.submit()"
                    class="h-10 rounded-lg border border-[#dbe1e6] bg-white px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
                <option value="consultations" selected="@(Model.ReportType == "consultations")">Consultations</option>
                <option value="users"         selected="@(Model.ReportType == "users")">Users</option>
                <option value="inventory"     selected="@(Model.ReportType == "inventory")">Inventory</option>
            </select>
        </div>

        @* Date From *@
        <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-[#617789]">From</label>
            <input type="date" name="dateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")"
                   class="h-10 rounded-lg border border-[#dbe1e6] bg-white px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20" />
        </div>

        @* Date To *@
        <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-[#617789]">To</label>
            <input type="date" name="dateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")"
                   class="h-10 rounded-lg border border-[#dbe1e6] bg-white px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20" />
        </div>

        @* Status Filter (consultations only) *@
        @if (Model.ReportType == "consultations")
        {
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold uppercase tracking-wider text-[#617789]">Status</label>
                <select name="statusFilter"
                        class="h-10 rounded-lg border border-[#dbe1e6] bg-white px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="">All Statuses</option>
                    <option value="Pending"     selected="@(Model.StatusFilter == "Pending")">Pending</option>
                    <option value="UnderReview" selected="@(Model.StatusFilter == "UnderReview")">Under Review</option>
                    <option value="Completed"   selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Cancelled"   selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
        }

        @* Generate *@
        <button type="submit"
                class="h-10 flex items-center gap-2 bg-primary hover:bg-blue-700 text-white px-5 rounded-lg text-sm font-bold transition-colors">
            <span class="material-symbols-outlined text-base">refresh</span>
            Generate
        </button>

        @* Export *@
        <a asp-action="ExportReport" asp-controller="Admin"
           asp-route-reportType="@Model.ReportType"
           asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")"
           asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")"
           asp-route-statusFilter="@Model.StatusFilter"
           class="h-10 flex items-center gap-2 border border-[#dbe1e6] hover:bg-[#f0f3f4] text-[#111518] px-5 rounded-lg text-sm font-bold transition-colors">
            <span class="material-symbols-outlined text-base">download</span>
            Export CSV
        </a>

    </form>
</div>

@* ══════════════════════════════════════════════════
   CONSULTATION REPORT
══════════════════════════════════════════════════ *@
@if (Model.ReportType == "consultations")
{
    @* Summary Cards *@
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-primary">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Total</p>
            <p class="text-3xl font-black">@Model.TotalConsultations</p>
        </div>
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-green-500">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Completed</p>
            <p class="text-3xl font-black text-green-600">@Model.CompletedConsultations</p>
        </div>
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-amber-500">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Pending</p>
            <p class="text-3xl font-black text-amber-600">@Model.PendingConsultations</p>
        </div>
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-blue-500">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Under Review</p>
            <p class="text-3xl font-black text-blue-600">@Model.UnderReviewConsultations</p>
        </div>
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-slate-400">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Avg. Time</p>
            <p class="text-3xl font-black">@Model.AvgCompletionHours.ToString("F1")<span class="text-base font-medium text-[#617789]">h</span></p>
        </div>
    </div>

    @* Table *@
    <div class="rounded-xl border border-[#dbe1e6] bg-white shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-[#dbe1e6]">
            <h3 class="font-bold text-[#111518]">Consultation Records</h3>
            <span class="text-xs text-[#617789]">@Model.ConsultationRows.Count records</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-[#fcfcfd] border-b border-[#dbe1e6]">
                    <tr>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">ID</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Patient</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Symptoms</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Severity</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Status</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Pharmacist</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Submitted</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Time to Complete</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#dbe1e6]">
                    @if (!Model.ConsultationRows.Any())
                    {
                        <tr>
                            <td colspan="8" class="px-4 py-12 text-center text-[#617789] text-sm">
                                <span class="material-symbols-outlined text-3xl block mb-2">search_off</span>
                                No consultations found for the selected filters.
                            </td>
                        </tr>
                    }
                    @foreach (var row in Model.ConsultationRows)
                    {
                        var statusCss = row.Status switch {
                            "Completed"   => "bg-green-50 text-green-700",
                            "Pending"     => "bg-amber-50 text-amber-700",
                            "UnderReview" => "bg-blue-50 text-blue-700",
                            "Cancelled"   => "bg-slate-100 text-slate-600",
                            _             => "bg-slate-100 text-slate-600"
                        };
                        var severityCss = row.Severity switch {
                            "Severe"   => "bg-red-50 text-red-700",
                            "Moderate" => "bg-amber-50 text-amber-700",
                            "Mild"     => "bg-green-50 text-green-700",
                            _          => "bg-slate-100 text-slate-500"
                        };
                        <tr class="hover:bg-[#f8fafc] transition-colors">
                            <td class="px-4 py-3 text-xs font-bold text-[#617789]">#@row.ConsultationId.ToString("D4")</td>
                            <td class="px-4 py-3">
                                <p class="font-semibold text-[#111518]">@row.PatientName</p>
                                <p class="text-xs text-[#617789]">@row.PatientEmail</p>
                            </td>
                            <td class="px-4 py-3 max-w-[200px]">
                                <p class="text-xs text-[#617789] truncate">@row.Symptoms</p>
                            </td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-1 rounded-md text-xs font-bold @severityCss">@(row.Severity == "-" ? "—" : row.Severity)</span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-1 rounded-md text-xs font-bold @statusCss">@row.Status</span>
                            </td>
                            <td class="px-4 py-3 text-xs text-[#617789]">@(row.PharmacistName ?? "—")</td>
                            <td class="px-4 py-3 text-xs text-[#617789]">@row.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="px-4 py-3 text-xs text-[#617789]">
                                @(row.HoursToComplete.HasValue ? $"{row.HoursToComplete.Value:F1}h" : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════
   USER REPORT
══════════════════════════════════════════════════ *@
else if (Model.ReportType == "users")
{
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-primary">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Total Users</p>
            <p class="text-3xl font-black">@Model.TotalUsers</p>
        </div>
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-blue-400">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Patients</p>
            <p class="text-3xl font-black">@Model.TotalPatients</p>
        </div>
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-purple-500">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Pharmacists</p>
            <p class="text-3xl font-black">@Model.TotalPharmacists</p>
        </div>
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-green-500">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">New in Range</p>
            <p class="text-3xl font-black text-green-600">@Model.NewUsersInRange</p>
        </div>
    </div>

    <div class="rounded-xl border border-[#dbe1e6] bg-white shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-[#dbe1e6]">
            <h3 class="font-bold text-[#111518]">User Records</h3>
            <span class="text-xs text-[#617789]">@Model.UserRows.Count records</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-[#fcfcfd] border-b border-[#dbe1e6]">
                    <tr>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">User</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Role</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Phone</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Joined</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#dbe1e6]">
                    @if (!Model.UserRows.Any())
                    {
                        <tr>
                            <td colspan="4" class="px-4 py-12 text-center text-[#617789] text-sm">
                                <span class="material-symbols-outlined text-3xl block mb-2">search_off</span>
                                No users found.
                            </td>
                        </tr>
                    }
                    @foreach (var row in Model.UserRows)
                    {
                        var roleCss = row.Role switch {
                            "Admin"      => "bg-primary text-white",
                            "Pharmacist" => "bg-purple-100 text-purple-700",
                            _            => "bg-blue-50 text-primary"
                        };
                        <tr class="hover:bg-[#f8fafc] transition-colors">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-xs">
                                        @row.FullName.Substring(0,1).ToUpper()
                                    </div>
                                    <div>
                                        <p class="font-semibold text-[#111518]">@row.FullName</p>
                                        <p class="text-xs text-[#617789]">@row.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-1 rounded-md text-xs font-bold @roleCss">@row.Role</span>
                            </td>
                            <td class="px-4 py-3 text-xs text-[#617789]">@(row.Phone ?? "—")</td>
                            <td class="px-4 py-3 text-xs text-[#617789]">@row.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════
   INVENTORY REPORT
══════════════════════════════════════════════════ *@
else if (Model.ReportType == "inventory")
{
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-primary">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Total Medications</p>
            <p class="text-3xl font-black">@Model.TotalMedications</p>
        </div>
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-amber-500">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Low Stock</p>
            <p class="text-3xl font-black text-amber-600">@Model.LowStockCount</p>
        </div>
        <div class="bg-white rounded-xl border border-[#dbe1e6] p-5 shadow-sm border-l-4 border-l-red-500">
            <p class="text-xs font-semibold text-[#617789] uppercase tracking-wider mb-1">Out of Stock</p>
            <p class="text-3xl font-black text-red-600">@Model.OutOfStockCount</p>
        </div>
    </div>

    <div class="rounded-xl border border-[#dbe1e6] bg-white shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-[#dbe1e6]">
            <h3 class="font-bold text-[#111518]">Inventory Records</h3>
            <span class="text-xs text-[#617789]">@Model.InventoryRows.Count items</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-[#fcfcfd] border-b border-[#dbe1e6]">
                    <tr>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Medicine</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Category</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Quantity</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Status</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#617789]">Expiry</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#dbe1e6]">
                    @if (!Model.InventoryRows.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-4 py-12 text-center text-[#617789] text-sm">
                                <span class="material-symbols-outlined text-3xl block mb-2">inventory_2</span>
                                No inventory data found.
                            </td>
                        </tr>
                    }
                    @foreach (var row in Model.InventoryRows)
                    {
                        var stockCss = row.StockStatus switch {
                            "Out" => "bg-red-50 text-red-700",
                            "Low" => "bg-amber-50 text-amber-700",
                            _     => "bg-green-50 text-green-700"
                        };
                        <tr class="hover:bg-[#f8fafc] transition-colors">
                            <td class="px-4 py-3 font-semibold text-[#111518]">@row.MedicineName</td>
                            <td class="px-4 py-3 text-xs text-[#617789]">@(row.Category ?? "—")</td>
                            <td class="px-4 py-3 font-bold">@row.Quantity</td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-1 rounded-md text-xs font-bold @stockCss">@row.StockStatus</span>
                            </td>
                            <td class="px-4 py-3 text-xs text-[#617789]">@(row.ExpiryDate ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
