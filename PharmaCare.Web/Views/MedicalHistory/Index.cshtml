@model IEnumerable<PharmaCare.Data.Models.MedicalHistory>
@{
    ViewData["Title"] = "Medical History";
    Layout = "_LayoutAuth";
}

<!-- Page Header -->
<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-[#111518] dark:text-white">Medical History</h1>
        <p class="text-[#617989] mt-1">Manage and track your diagnosed health conditions.</p>
    </div>
    <button onclick="openAddModal()" class="flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-primary/90 transition-all active:scale-95">
        <span class="material-symbols-outlined text-lg">add</span>
        <span>Add New Condition</span>
    </button>
</div>

@{
    var historyList = Model?.ToList() ?? new List<PharmaCare.Data.Models.MedicalHistory>();
    var totalCount = historyList.Count;
    var active = historyList.Count(h => h.IsActive);
    var inactive = historyList.Count(h => !h.IsActive);
}

<!-- Stats Bar -->
<div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="flex flex-col gap-1 rounded-xl border border-[#dbe1e6] dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm">
        <span class="text-sm font-medium text-[#617989]">Total Conditions</span>
        <span class="text-3xl font-bold text-[#111518] dark:text-white">@totalCount</span>
    </div>
    <div class="flex flex-col gap-1 rounded-xl border border-[#dbe1e6] dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm">
        <span class="text-sm font-medium text-[#617989]">Active</span>
        <div class="flex items-center gap-2">
            <span class="text-3xl font-bold text-[#111518] dark:text-white">@active</span>
            <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </div>
    </div>
    <div class="flex flex-col gap-1 rounded-xl border border-[#dbe1e6] dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm">
        <span class="text-sm font-medium text-[#617989]">Inactive</span>
        <div class="flex items-center gap-2">
            <span class="text-3xl font-bold text-[#111518] dark:text-white">@inactive</span>
            <span class="flex h-2 w-2 rounded-full bg-slate-400"></span>
        </div>
    </div>
</div>

@if (!historyList.Any())
{
    <!-- Empty State -->
    <div class="mt-12 flex flex-col items-center justify-center text-center p-12 rounded-3xl border-2 border-dashed border-[#dbe1e6] dark:border-slate-800">
        <div class="mb-6 flex h-24 w-24 items-center justify-center rounded-full bg-primary/5 text-primary">
            <span class="material-symbols-outlined !text-6xl">medical_information</span>
        </div>
        <h3 class="text-2xl font-bold text-[#111518] dark:text-white">No Medical History</h3>
        <p class="mt-2 max-w-sm text-[#617989]">
            Start by adding your first diagnosed condition to keep your medical records up to date.
        </p>
        <button onclick="openAddModal()" class="mt-8 flex items-center justify-center gap-2 rounded-lg bg-primary px-6 py-3 text-base font-bold text-white shadow-lg hover:bg-primary/90 transition-all active:scale-95">
            <span class="material-symbols-outlined text-xl">add_circle</span>
            <span>Add My First Condition</span>
        </button>
    </div>
}
else
{
    <!-- Conditions List -->
    <div class="space-y-4">
        @foreach (var history in historyList.OrderByDescending(h => h.IsActive).ThenByDescending(h => h.DiagnosedDate))
        {
            <div class="group relative flex flex-col gap-4 rounded-xl border border-[#dbe1e6] dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm transition-all hover:border-primary/50 md:flex-row md:items-center @(!history.IsActive ? "opacity-80" : "")">
                <div class="flex flex-1 items-start gap-5">
                    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl @(history.IsActive ? "bg-primary/10 text-primary" : "bg-slate-100 dark:bg-slate-800 text-[#617989]")">
                        <span class="material-symbols-outlined text-3xl">@GetConditionIcon(history.ConditionName)</span>
                    </div>
                    <div class="flex flex-col flex-1">
                        <div class="flex flex-wrap items-center gap-3">
                            <h3 class="text-lg font-bold text-[#111518] dark:text-white">@history.ConditionName</h3>
                            @if (history.IsActive)
                            {
                                <div class="flex items-center gap-1.5 rounded-full bg-emerald-100 dark:bg-emerald-500/10 px-2.5 py-0.5 text-xs font-bold text-emerald-700 dark:text-emerald-400">
                                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                    ACTIVE
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-1.5 rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 text-xs font-bold text-slate-600 dark:text-slate-400">
                                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                    INACTIVE
                                </div>
                            }
                        </div>
                        <p class="text-sm font-medium text-[#617989] mt-0.5">
                            @if (history.DiagnosedDate.HasValue)
                            {
                                <text>Diagnosed: @history.DiagnosedDate.Value.ToString("MMM yyyy")</text>
                            }
                            else
                            {
                                <text>Status: @(history.IsActive ? "Active" : "Resolved")</text>
                            }
                        </p>
                        @if (!string.IsNullOrEmpty(history.Notes))
                        {
                            <div class="mt-3 flex items-start gap-2 rounded-lg bg-[#f0f3f4] dark:bg-slate-800/50 p-3">
                                <span class="material-symbols-outlined text-sm text-[#617989] mt-0.5">description</span>
                                <p class="text-sm text-[#111518] dark:text-slate-300"><span class="font-semibold">Notes:</span> @history.Notes</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="flex items-center justify-end gap-2 border-t border-[#f0f3f4] dark:border-slate-800 pt-4 md:border-t-0 md:pt-0">
                    <button onclick='openEditModal(@Json.Serialize(new { 
                        historyId = history.MedicalHistoryId, 
                        conditionName = history.ConditionName, 
                        diagnosedDate = history.DiagnosedDate?.ToString("yyyy-MM-dd"), 
                        isActive = history.IsActive, 
                        notes = history.Notes 
                    }))' class="flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold text-[#111518] dark:text-white hover:bg-[#f0f3f4] dark:hover:bg-slate-800 transition-colors">
                        <span class="material-symbols-outlined text-lg">edit</span>
                        Edit
                    </button>
                    <button onclick="confirmDelete(@history.MedicalHistoryId, '@history.ConditionName')" class="flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold text-red-600 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors">
                        <span class="material-symbols-outlined text-lg">delete</span>
                        Delete
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- Add/Edit Medical History Modal -->
<div id="historyModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-slate-900 rounded-xl max-w-lg w-full shadow-2xl my-8">
        <div class="p-6">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6" id="modalTitle">Add Medical Condition</h2>

            <form asp-controller="MedicalHistory" asp-action="Create" method="post" id="historyForm" class="space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MedicalHistoryId" id="historyId" value="0" />
                <input type="hidden" name="PatientId" value="@ViewBag.PatientId" />

                <!-- Condition Name -->
                <div>
                    <label class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Condition Name *</label>
                    <input type="text" name="ConditionName" id="conditionName" required maxlength="200"
                           class="w-full rounded-lg border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 focus:ring-primary focus:border-primary"
                           placeholder="e.g., Hypertension, Type 2 Diabetes" />
                </div>

                <!-- Diagnosed Date -->
                <div>
                    <label class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Diagnosed Date (Optional)</label>
                    <input type="date" name="DiagnosedDate" id="diagnosedDate"
                           class="w-full rounded-lg border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 focus:ring-primary focus:border-primary" />
                </div>

                <!-- Status -->
                <div>
                    <label class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Status *</label>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="IsActive" value="true" checked
                                   class="w-4 h-4 text-primary focus:ring-primary border-slate-300" />
                            <span class="flex items-center gap-1.5 text-sm font-medium">
                                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                                Active
                            </span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="IsActive" value="false"
                                   class="w-4 h-4 text-primary focus:ring-primary border-slate-300" />
                            <span class="flex items-center gap-1.5 text-sm font-medium">
                                <span class="h-2 w-2 rounded-full bg-slate-400"></span>
                                Inactive
                            </span>
                        </label>
                    </div>
                </div>

                <!-- Notes -->
                <div>
                    <label class="block text-sm font-semibold mb-2 text-slate-700 dark:text-slate-300">Notes (Optional)</label>
                    <textarea name="Notes" id="notes" maxlength="500" rows="3"
                              class="w-full rounded-lg border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 focus:ring-primary focus:border-primary"
                              placeholder="Additional information about the condition..."></textarea>
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-3 justify-end pt-4 border-t border-slate-200 dark:border-slate-800">
                    <button type="button" onclick="closeHistoryModal()"
                            class="px-5 py-2.5 rounded-lg font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                        Cancel
                    </button>
                    <button type="submit"
                            class="bg-primary text-white px-6 py-2.5 rounded-lg font-semibold hover:opacity-90 shadow-md transition-all">
                        <span id="submitButtonText">Save Condition</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-xl max-w-md w-full p-6 shadow-2xl">
        <div class="flex items-start gap-4 mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-100 dark:bg-red-900/40 text-red-600 flex-shrink-0">
                <span class="material-symbols-outlined text-3xl">warning</span>
            </div>
            <div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Delete Medical Condition?</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">
                    Are you sure you want to delete this condition?
                </p>
                <p class="text-sm font-semibold text-gray-900 dark:text-white" id="deleteConditionName"></p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
                    This action cannot be undone.
                </p>
            </div>
        </div>
        <form id="deleteForm" method="post">
            @Html.AntiForgeryToken()
            <div class="flex gap-3 justify-end mt-6">
                <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded-lg text-sm font-bold text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-all">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-bold transition-all">
                    Yes, Delete
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Add Modal
        function openAddModal() {
            document.getElementById('modalTitle').textContent = 'Add Medical Condition';
            document.getElementById('submitButtonText').textContent = 'Save Condition';
            document.getElementById('historyForm').action = '@Url.Action("Create", "MedicalHistory")';
            document.getElementById('historyForm').reset();
            document.getElementById('historyId').value = '0';
            document.querySelector('input[name="IsActive"][value="true"]').checked = true;
            document.getElementById('historyModal').classList.remove('hidden');
        }

        // Edit Modal
        function openEditModal(data) {
            document.getElementById('modalTitle').textContent = 'Edit Medical Condition';
            document.getElementById('submitButtonText').textContent = 'Update Condition';
            document.getElementById('historyForm').action = '@Url.Action("Edit", "MedicalHistory")/' + data.historyId;

            document.getElementById('historyId').value = data.historyId;
            document.getElementById('conditionName').value = data.conditionName;
            document.getElementById('diagnosedDate').value = data.diagnosedDate || '';
            document.getElementById('notes').value = data.notes || '';
            
            const activeRadio = document.querySelector('input[name="IsActive"][value="' + data.isActive + '"]');
            if (activeRadio) activeRadio.checked = true;

            document.getElementById('historyModal').classList.remove('hidden');
        }

        function closeHistoryModal() {
            document.getElementById('historyModal').classList.add('hidden');
        }

        // Delete confirmation
        function confirmDelete(historyId, conditionName) {
            document.getElementById('deleteConditionName').textContent = 'Condition: ' + conditionName;
            document.getElementById('deleteForm').action = '/MedicalHistory/Delete/' + historyId;
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
        }

        // Close modals on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeHistoryModal();
                closeDeleteModal();
            }
        });

        // Close modals on background click
        document.getElementById('historyModal')?.addEventListener('click', function (e) {
            if (e.target === this) closeHistoryModal();
        });
        document.getElementById('deleteModal')?.addEventListener('click', function (e) {
            if (e.target === this) closeDeleteModal();
        });
    </script>
}

@functions {
    private string GetConditionIcon(string conditionName)
    {
        if (string.IsNullOrEmpty(conditionName)) return "medical_information";
        
        var lower = conditionName.ToLower();
        if (lower.Contains("hypertension") || lower.Contains("blood pressure")) return "cardiology";
        if (lower.Contains("diabetes")) return "blood_pressure";
        if (lower.Contains("asthma") || lower.Contains("respiratory")) return "respiratory";
        if (lower.Contains("arthritis") || lower.Contains("joint")) return "skeleton";
        if (lower.Contains("allergy") || lower.Contains("allergic")) return "pill";
        if (lower.Contains("heart") || lower.Contains("cardiac")) return "cardiology";
        
        return "medical_information";
    }
}