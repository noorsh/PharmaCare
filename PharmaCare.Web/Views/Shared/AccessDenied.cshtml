<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Access Denied - PharmaCare</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#1192ee",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101a22",
                        "navy-custom": "#111518",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 48;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark min-h-screen flex flex-col font-display">
<!-- Main Content: Access Denied Card -->
<main class="flex-grow flex items-center justify-center p-6">
<div class="max-w-lg w-full bg-white dark:bg-slate-900 rounded-xl shadow-xl shadow-gray-200/50 dark:shadow-none p-8 md:p-12 text-center border border-gray-100 dark:border-gray-800">
<!-- Error Icon Section -->
<div class="mb-8 flex justify-center">
<div class="relative flex items-center justify-center">
<div class="absolute w-24 h-24 bg-red-500/10 dark:bg-red-500/20 rounded-full animate-pulse"></div>
<div class="relative w-20 h-20 bg-red-500 rounded-full flex items-center justify-center shadow-lg shadow-red-200 dark:shadow-none">
<span aria-hidden="true" class="material-symbols-outlined text-white text-4xl">lock_person</span>
</div>
</div>
</div>
<!-- Text Content -->
<div class="space-y-4 mb-10">
<h2 class="text-navy-custom dark:text-white text-3xl font-bold tracking-tight">Access Restricted</h2>
<div class="h-1 w-12 bg-primary mx-auto rounded-full"></div>
<p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed max-w-sm mx-auto">
                    You do not have the required permissions to view this page. If you believe this is an error, please contact your system administrator.
                </p>
</div>
<!-- Action Buttons -->
<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
<a href="@ViewBag.RedirectUrl"  class="w-full sm:w-auto px-8 py-3 bg-primary hover:bg-primary/90 text-white font-bold rounded-lg transition-all transform active:scale-95 shadow-md shadow-primary/20">
                    Back to Dashboard
                </a>

</div>
</div>
</main>
<!-- Footer -->
<footer class="w-full py-10 px-6 border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-background-dark">
<div class="max-w-7xl mx-auto flex flex-col items-center gap-6">
<div class="flex flex-wrap justify-center gap-x-12 gap-y-4">
<a class="text-gray-500 dark:text-gray-400 text-sm hover:text-primary transition-colors" href="#">Privacy Policy</a>
<a class="text-gray-500 dark:text-gray-400 text-sm hover:text-primary transition-colors" href="#">Terms of Service</a>
<a class="text-gray-500 dark:text-gray-400 text-sm hover:text-primary transition-colors" href="#">Help Center</a>
<a class="text-gray-500 dark:text-gray-400 text-sm hover:text-primary transition-colors" href="#">System Status</a>
</div>
<p class="text-gray-400 dark:text-gray-500 text-sm">
                © 2024 PharmaCare AI-Powered Healthcare. All rights reserved.
            </p>
</div>
</footer>
</body></html>