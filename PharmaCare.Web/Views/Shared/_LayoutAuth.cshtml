@inject Microsoft.AspNetCore.Identity.UserManager<PharmaCare.Data.Models.ApplicationUser> _userManager
@{
var _currentUser = await _userManager.GetUserAsync(User);
var _photoUrl    = _currentUser?.ProfilePhotoUrl;
var _initials    = (_currentUser?.FirstName?.Substring(0, 1) ?? User.Identity?.Name?.Substring(0, 1) ?? "U").ToUpper();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmaCare</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary":          "#1392ec",
                        "background-light": "#f6f7f8",
                        "background-dark":  "#101a22",
                        "warning":          "#f59e0b",
                        "success":          "#10b981",
                        "error":            "#ef4444",
                    },
                    fontFamily: { "display": ["Inter", "sans-serif"] },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg":      "0.5rem",
                        "xl":      "0.75rem",
                        "full":    "9999px"
                    },
                },
            },
        }
    </script>

    <style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-[#111518] dark:text-white font-display">

@* ═══════════════════════════════════════════════════
   TOP NAVIGATION BAR
════════════════════════════════════════════════════ *@
<header class="fixed top-0 left-0 right-0 h-16 bg-white dark:bg-[#1a2632] border-b border-[#e5e7eb] dark:border-[#2d3a4b] z-50 flex items-center justify-between px-6">

    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3">
        <div class="bg-primary p-1.5 rounded-lg flex items-center justify-center">
            <span class="material-symbols-outlined text-white text-2xl">health_metrics</span>
        </div>
        <h1 class="text-xl font-extrabold tracking-tight">PharmaCare</h1>
    </a>

    <div class="flex items-center gap-4">

        @* ── PHARMACIST / ADMIN BELL ──────────────────────────────── *@
        @if (User.IsInRole("Pharmacist") || User.IsInRole("Admin"))
        {
        <div class="relative" id="notificationBell">
            <button onclick="toggleNotifications()"
                    class="p-2 text-[#617789] dark:text-[#94a3b8] hover:bg-[#f0f2f4] dark:hover:bg-[#243341] rounded-full relative">
                <span class="material-symbols-outlined">notifications</span>
                <span id="notifBadge"
                      class="hidden absolute -top-0.5 -right-0.5 size-5 bg-red-500 text-white text-[10px] font-bold rounded-full items-center justify-center">
                        0
                    </span>
            </button>

            <div id="notifDropdown"
                 class="hidden absolute right-0 mt-2 w-80 bg-white dark:bg-[#1a2632] border border-[#e5e7eb] dark:border-[#2d3a4b] rounded-xl shadow-xl overflow-hidden z-50">
                <div class="flex items-center justify-between px-4 py-3 border-b border-[#e5e7eb] dark:border-[#2d3a4b]">
                    <h3 class="font-bold text-sm">Notifications</h3>
                    <span id="notifCount" class="bg-primary/10 text-primary text-xs font-bold px-2 py-0.5 rounded-full">0</span>
                </div>
                <div id="notifList" class="max-h-80 overflow-y-auto divide-y divide-[#e5e7eb] dark:divide-[#2d3a4b]">
                    <div class="px-4 py-6 text-center text-[#617789] text-sm">
                        <span class="material-symbols-outlined text-3xl block mb-2">notifications_none</span>
                        All caught up!
                    </div>
                </div>
                <div class="px-4 py-3 border-t border-[#e5e7eb] dark:border-[#2d3a4b] bg-slate-50 dark:bg-[#0f1923]">
                    <a asp-controller="Consultation" asp-action="Queue"
                       class="text-primary text-xs font-bold hover:underline">
                        View consultation queue →
                    </a>
                </div>
            </div>
        </div>
        }

        @* ── PATIENT BELL ─────────────────────────────────────────── *@
        else if (User.IsInRole("Patient"))
        {
        <div class="relative" id="patientNotificationBell">
            <button onclick="togglePatientNotifications()"
                    class="p-2 text-[#617789] dark:text-[#94a3b8] hover:bg-[#f0f2f4] dark:hover:bg-[#243341] rounded-full relative">
                <span class="material-symbols-outlined">notifications</span>
                <span id="patientNotifBadge"
                      class="hidden absolute -top-0.5 -right-0.5 size-5 bg-red-500 text-white text-[10px] font-bold rounded-full items-center justify-center">
                        0
                    </span>
            </button>

            <div id="patientNotifDropdown"
                 class="hidden absolute right-0 mt-2 w-80 bg-white dark:bg-[#1a2632] border border-[#e5e7eb] dark:border-[#2d3a4b] rounded-xl shadow-xl overflow-hidden z-50">
                <div class="flex items-center justify-between px-4 py-3 border-b border-[#e5e7eb] dark:border-[#2d3a4b]">
                    <h3 class="font-bold text-sm">Notifications</h3>
                    <span id="patientNotifCount" class="bg-primary/10 text-primary text-xs font-bold px-2 py-0.5 rounded-full">0</span>
                </div>
                <div id="patientNotifList" class="max-h-80 overflow-y-auto divide-y divide-[#e5e7eb] dark:divide-[#2d3a4b]">
                    <div class="px-4 py-6 text-center text-[#617789] text-sm">
                        <span class="material-symbols-outlined text-3xl block mb-2">notifications_none</span>
                        All caught up!
                    </div>
                </div>
                <div class="px-4 py-3 border-t border-[#e5e7eb] dark:border-[#2d3a4b] bg-slate-50 dark:bg-[#0f1923]">
                    <a asp-controller="Consultation" asp-action="MyConsultations"
                       class="text-primary text-xs font-bold hover:underline">
                        View my consultations →
                    </a>
                </div>
            </div>
        </div>
        }

        @* ── NO BELL (other roles) ────────────────────────────────── *@
        else
        {
        <button class="p-2 text-[#617789] dark:text-[#94a3b8] hover:bg-[#f0f2f4] dark:hover:bg-[#243341] rounded-full">
            <span class="material-symbols-outlined">notifications</span>
        </button>
        }

        <div class="h-8 w-[1px] bg-[#e5e7eb] dark:bg-[#2d3a4b] mx-2"></div>

        @* ── USER DROPDOWN ────────────────────────────────────────── *@
        <div class="relative group">
            <div class="flex items-center gap-3 cursor-pointer">
                <div class="text-right hidden sm:block">
                    <p class="text-sm font-semibold leading-none">@User.Identity.Name</p>
                    <p class="text-xs text-[#617789] dark:text-[#94a3b8]">
                        @if (User.IsInRole("Patient"))          { <text>Patient</text>        }
                        else if (User.IsInRole("Pharmacist"))   { <text>Pharmacist</text>     }
                        else if (User.IsInRole("Admin"))        { <text>Administrator</text>  }
                    </p>
                </div>
                @if (!string.IsNullOrEmpty(_photoUrl))
                {
                <img src="@_photoUrl" alt="@_initials" class="size-10 rounded-full object-cover" />
                }
                else
                {
                <div class="size-10 rounded-full bg-primary text-white flex items-center justify-center font-bold text-lg select-none">@_initials</div>
                }
                <span class="material-symbols-outlined text-sm text-[#617789]">expand_more</span>
            </div>

            <div class="hidden group-hover:block absolute right-0 pt-2 w-48 bg-white dark:bg-[#1a2632] border border-[#e5e7eb] dark:border-[#2d3a4b] rounded-lg shadow-lg overflow-hidden">
                @if (User.IsInRole("Patient"))
                {
                <a asp-controller="Patient" asp-action="Profile"
                   class="flex items-center gap-2 px-4 py-2 text-sm hover:bg-[#f0f2f4] dark:hover:bg-[#243341] transition-colors">
                    <span class="material-symbols-outlined text-sm">person</span>
                    My Profile
                </a>
                <a asp-controller="Patient" asp-action="Edit"
                   class="flex items-center gap-2 px-4 py-2 text-sm hover:bg-[#f0f2f4] dark:hover:bg-[#243341] transition-colors">
                    <span class="material-symbols-outlined text-sm">edit</span>
                    Edit Profile
                </a>
                }
                <div class="border-t border-[#e5e7eb] dark:border-[#2d3a4b]"></div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit"
                            class="w-full flex items-center gap-2 px-4 py-2 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/10 transition-colors">
                        <span class="material-symbols-outlined text-sm">logout</span>
                        Logout
                    </button>
                </form>
            </div>
        </div>

    </div>
</header>

@* ═══════════════════════════════════════════════════
   BODY LAYOUT (sidebar + main)
════════════════════════════════════════════════════ *@
<div class="flex pt-16">

    @* ── SIDEBAR ──────────────────────────────────────────────── *@
    <aside class="fixed left-0 w-64 h-[calc(100vh-64px)] bg-[#f6f7f8] dark:bg-[#0f1720] border-r border-[#e5e7eb] dark:border-[#2d3a4b] overflow-y-auto hidden lg:block">
        <nav class="p-4 space-y-1">

            @* Patient nav *@
            @if (User.IsInRole("Patient"))
            {
            <a asp-controller="Patient" asp-action="Dashboard"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Patient" asp-action="Profile"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">person</span>
                <span>My Profile</span>
            </a>

            <a asp-controller="MedicalHistory" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "MedicalHistory"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">history</span>
                <span>Medical History</span>
            </a>

            <a asp-controller="Allergy" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Allergy"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">warning</span>
                <span>Allergies</span>
            </a>

            <a asp-controller="CurrentMedication" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "CurrentMedication"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">pill</span>
                <span>Current Medications</span>
            </a>

            <a asp-controller="Consultation" asp-action="Start"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Consultation" && ViewContext.RouteData.Values["action"]?.ToString() == "Start"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">chat</span>
                <span>New Consultation</span>
            </a>

            <a asp-controller="Consultation" asp-action="MyConsultations"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Consultation" && ViewContext.RouteData.Values["action"]?.ToString() == "MyConsultations"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">folder_open</span>
                <span>Consultation History</span>
            </a>

            <a asp-controller="Patient" asp-action="ActivityLog"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "ActivityLog"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">timeline</span>
                <span>Activity Log</span>
            </a>
            }

            @* Pharmacist nav *@
            else if (User.IsInRole("Pharmacist"))
            {
            <a asp-controller="Pharmacist" asp-action="Dashboard"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pharmacist" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Consultation" asp-action="Queue"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Consultation" && ViewContext.RouteData.Values["action"]?.ToString() == "Queue"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">pending_actions</span>
                <span>Consultation Queue</span>
            </a>

            <a asp-controller="Consultation" asp-action="History"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Consultation" && ViewContext.RouteData.Values["action"]?.ToString() == "History"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">history</span>
                <span>Consultation History</span>
            </a>

            <a asp-controller="Pharmacist" asp-action="Patients"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pharmacist" && ViewContext.RouteData.Values["action"]?.ToString() == "Patients"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">group</span>
                <span>Patients</span>
            </a>

            <a asp-controller="Inventory" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">inventory</span>
                <span>Inventory</span>
            </a>
            }

            @* Admin nav *@
            else if (User.IsInRole("Admin"))
            {
            <a asp-controller="Admin" asp-action="Dashboard"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Inventory" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">inventory</span>
                <span>Inventory</span>
            </a>

            <a asp-controller="Admin" asp-action="Users"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Users"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">people</span>
                <span>Users</span>
            </a>
            }

        </nav>

        <div class="mt-8 px-4 pb-4">
            <p class="px-3 text-[10px] font-bold text-[#94a3b8] uppercase tracking-widest mb-2">Support</p>
            <a href="#"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632] transition-colors">
                <span class="material-symbols-outlined">help</span>
                <span>Help Center</span>
            </a>
            <a asp-controller="Account" asp-action="ChangePassword"
               class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors
                      @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "ChangePassword"
               ? "bg-primary text-white font-medium"
               : "text-[#4b5563] dark:text-[#94a3b8] hover:bg-[#e2e8f0] dark:hover:bg-[#1a2632]")">
                <span class="material-symbols-outlined">settings</span>
                <span>Settings</span>
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-4">
                <button type="submit"
                        class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-red-500 hover:bg-red-50 dark:hover:bg-red-900/10 transition-colors">
                    <span class="material-symbols-outlined">logout</span>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    @* ── MAIN CONTENT ─────────────────────────────────────────── *@
    <main class="flex-1 lg:ml-64 bg-[#fafafa] dark:bg-[#0b1218] min-h-[calc(100vh-64px)] p-6 lg:p-8">

        @if (TempData["Success"] != null)
        {
        <div class="mb-6 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg flex items-center gap-2">
            <span class="material-symbols-outlined">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
        }
        @if (TempData["Error"] != null)
        {
        <div class="mb-6 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg flex items-center gap-2">
            <span class="material-symbols-outlined">error</span>
            <span>@TempData["Error"]</span>
        </div>
        }

        @RenderBody()

    </main>
</div>

@* ═══════════════════════════════════════════════════
   SCRIPTS
════════════════════════════════════════════════════ *@
<script src="/lib/jquery/dist/jquery.min.js"></script>

@* ── SHARED notification helpers ─────────────────────────────────── *@
<script>
    function updateBadge(count, badgeId, countId) {
        const badge   = document.getElementById(badgeId);
        const countEl = document.getElementById(countId);
        if (!badge) return;
        if (count > 0) {
            badge.textContent = count > 9 ? '9+' : count;
            badge.classList.remove('hidden');
            badge.classList.add('flex');
        } else {
            badge.classList.add('hidden');
            badge.classList.remove('flex');
        }
        if (countEl) countEl.textContent = count;
    }

    function renderNotifications(notifications, listId) {
        const list = document.getElementById(listId);
        if (!list) return;

        if (!notifications || notifications.length === 0) {
            list.innerHTML = `
                <div class="px-4 py-6 text-center text-[#617789] text-sm">
                    <span class="material-symbols-outlined text-3xl block mb-2">notifications_none</span>
                    All caught up!
                </div>`;
            return;
        }

        const colorMap = {
            blue:  { bg: 'bg-blue-100 dark:bg-blue-900/30',   text: 'text-blue-600 dark:text-blue-400'  },
            green: { bg: 'bg-green-100 dark:bg-green-900/30', text: 'text-green-600 dark:text-green-400' },
            amber: { bg: 'bg-amber-100 dark:bg-amber-900/30', text: 'text-amber-600 dark:text-amber-400' },
            red:   { bg: 'bg-red-100 dark:bg-red-900/30',     text: 'text-red-600 dark:text-red-400'    }
        };

        list.innerHTML = notifications.map(n => {
            const c = colorMap[n.color] || colorMap.blue;
            return `
                <a href="${n.link}" class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50 dark:hover:bg-[#0f1923] transition-colors">
                    <div class="size-8 rounded-full ${c.bg} ${c.text} flex items-center justify-center flex-shrink-0 mt-0.5">
                        <span class="material-symbols-outlined text-[18px]">${n.icon}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-bold text-slate-800 dark:text-slate-100">${n.title}</p>
                        <p class="text-xs text-[#617789] mt-0.5 truncate">${n.message}</p>
                        <p class="text-[10px] text-[#94a3b8] mt-1">${n.time}</p>
                    </div>
                </a>`;
        }).join('');
    }
</script>

@* ── PHARMACIST / ADMIN notification script ──────────────────────── *@
@if (User.IsInRole("Pharmacist") || User.IsInRole("Admin"))
{
<script>
    // Key stores the last count the user has SEEN (opened the bell)
    const STORAGE_KEY = 'notif_seen_count_@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)';

    document.addEventListener('click', function (e) {
        const bell = document.getElementById('notificationBell');
        if (bell && !bell.contains(e.target))
            document.getElementById('notifDropdown').classList.add('hidden');
    });

    function toggleNotifications() {
        const dropdown = document.getElementById('notifDropdown');
        const isHidden = dropdown.classList.contains('hidden');
        dropdown.classList.toggle('hidden');
        if (isHidden) loadNotifications(true);
    }

    function loadNotifications(markSeen = false) {
        $.get('/Notification/GetNotifications', function (data) {
            const seenCount   = parseInt(localStorage.getItem(STORAGE_KEY) ?? '-1');
            const totalCount  = data.count;

            if (markSeen) {
                // User opened the bell — save current count as seen
                localStorage.setItem(STORAGE_KEY, totalCount.toString());
                updateBadge(0, 'notifBadge', 'notifCount');
            } else {
                // On background poll — show badge only if count grew since last seen
                const unseenCount = seenCount === -1
                    ? totalCount                          // first ever visit
                    : Math.max(0, totalCount - seenCount); // new items since last open
                updateBadge(unseenCount, 'notifBadge', 'notifCount');
            }

            renderNotifications(data.notifications, 'notifList');
        });
    }

    $(document).ready(function () {
        loadNotifications(false);
        setInterval(() => loadNotifications(false), 30000);
    });
</script>
}

