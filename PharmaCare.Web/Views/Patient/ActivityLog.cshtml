@model PharmaCare.MVC.Models.ViewModels.ActivityLogViewModel
@{
    ViewData["Title"] = "Activity Log";
    Layout = "_LayoutAuth";
}

@* ── Page Header ─────────────────────────────────────────────────────────── *@
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
        <h2 class="text-2xl font-black tracking-tight">Activity Log</h2>
        <p class="text-[#617789] dark:text-[#94a3b8] mt-1">
            A full timeline of everything recorded in your health profile.
        </p>
    </div>
    <a asp-controller="Patient" asp-action="Dashboard"
       class="inline-flex items-center gap-2 text-sm font-semibold text-[#617789] dark:text-[#94a3b8] hover:text-primary transition-colors">
        <span class="material-symbols-outlined text-base">arrow_back</span>
        Back to Dashboard
    </a>
</div>

@* ── Summary Cards ────────────────────────────────────────────────────────── *@
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">

    <div class="bg-white dark:bg-[#1a2632] p-5 rounded-xl border border-[#e5e7eb] dark:border-[#2d3a4b] shadow-sm">
        <div class="flex items-center gap-3 mb-1">
            <span class="material-symbols-outlined text-primary bg-primary/10 p-1.5 rounded-lg text-base">chat</span>
            <span class="text-2xl font-black">@Model.ConsultationCount</span>
        </div>
        <p class="text-xs font-medium text-[#617789] dark:text-[#94a3b8]">Consultations</p>
    </div>

    <div class="bg-white dark:bg-[#1a2632] p-5 rounded-xl border border-[#e5e7eb] dark:border-[#2d3a4b] shadow-sm">
        <div class="flex items-center gap-3 mb-1">
            <span class="material-symbols-outlined text-primary bg-primary/10 p-1.5 rounded-lg text-base">pill</span>
            <span class="text-2xl font-black">@Model.MedicationCount</span>
        </div>
        <p class="text-xs font-medium text-[#617789] dark:text-[#94a3b8]">Medications</p>
    </div>

    <div class="bg-white dark:bg-[#1a2632] p-5 rounded-xl border border-[#e5e7eb] dark:border-[#2d3a4b] shadow-sm">
        <div class="flex items-center gap-3 mb-1">
            <span class="material-symbols-outlined text-red-500 bg-red-100 dark:bg-red-500/10 p-1.5 rounded-lg text-base">warning</span>
            <span class="text-2xl font-black">@Model.AllergyCount</span>
        </div>
        <p class="text-xs font-medium text-[#617789] dark:text-[#94a3b8]">Allergies</p>
    </div>

    <div class="bg-white dark:bg-[#1a2632] p-5 rounded-xl border border-[#e5e7eb] dark:border-[#2d3a4b] shadow-sm">
        <div class="flex items-center gap-3 mb-1">
            <span class="material-symbols-outlined text-amber-500 bg-amber-100 dark:bg-amber-500/10 p-1.5 rounded-lg text-base">medical_information</span>
            <span class="text-2xl font-black">@Model.MedicalHistoryCount</span>
        </div>
        <p class="text-xs font-medium text-[#617789] dark:text-[#94a3b8]">Conditions</p>
    </div>

</div>

@* ── Timeline ─────────────────────────────────────────────────────────────── *@
@if (!Model.Groups.Any())
{
    <div class="bg-white dark:bg-[#1a2632] rounded-xl border border-[#e5e7eb] dark:border-[#2d3a4b] shadow-sm p-16 text-center">
        <span class="material-symbols-outlined text-5xl text-[#617789] dark:text-[#94a3b8] mb-4 block">history</span>
        <h3 class="text-lg font-bold mb-2">No activity yet</h3>
        <p class="text-[#617789] dark:text-[#94a3b8] text-sm mb-6">
            Start by adding your medical history or starting a consultation.
        </p>
        <a asp-controller="Consultation" asp-action="Start"
           class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-bold py-2.5 px-5 rounded-lg transition-all text-sm">
            <span class="material-symbols-outlined text-base">add_circle</span>
            Start a Consultation
        </a>
    </div>
}
else
{
    <div class="space-y-8">
        @foreach (var group in Model.Groups)
        {
            <div>
                @* Group Label *@
                <div class="flex items-center gap-3 mb-4">
                    <span class="text-xs font-black uppercase tracking-widest text-[#617789] dark:text-[#94a3b8]">
                        @group.Label
                    </span>
                    <div class="flex-1 h-[1px] bg-[#e5e7eb] dark:bg-[#2d3a4b]"></div>
                    <span class="text-xs font-semibold text-[#617789] dark:text-[#94a3b8]">
                        @group.Items.Count item@(group.Items.Count == 1 ? "" : "s")
                    </span>
                </div>

                @* Items *@
                <div class="bg-white dark:bg-[#1a2632] rounded-xl border border-[#e5e7eb] dark:border-[#2d3a4b] shadow-sm divide-y divide-[#e5e7eb] dark:divide-[#2d3a4b] overflow-hidden">
                    @foreach (var item in group.Items)
                    {
                        var tag = item.ActionLink != null ? "a" : "div";
                        <a href="@item.ActionLink"
                             class="flex items-start gap-4 px-5 py-4 @(item.ActionLink != null ? "hover:bg-[#f6f7f8] dark:hover:bg-[#0f1923] transition-colors cursor-pointer" : "")">

                            @* Icon *@
                            <div class="size-10 rounded-xl @item.IconBg flex items-center justify-center shrink-0 mt-0.5">
                                <span class="material-symbols-outlined @item.IconColor text-xl">@item.Icon</span>
                            </div>

                            @* Content *@
                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-2 mb-0.5">
                                    <p class="text-sm font-bold text-[#111518] dark:text-white">@item.Title</p>
                                    @if (!string.IsNullOrEmpty(item.BadgeText))
                                    {
                                        <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full @item.BadgeCss">
                                            @item.BadgeText
                                        </span>
                                    }
                                </div>
                                <p class="text-xs text-[#617789] dark:text-[#94a3b8] leading-relaxed">@item.Description</p>
                                <div class="flex items-center gap-2 mt-1.5">
                                    <span class="text-[10px] font-medium text-[#94a3b8]">@item.Category</span>
                                    <span class="text-[#e5e7eb] dark:text-[#2d3a4b]">·</span>
                                    <span class="text-[10px] font-medium text-[#94a3b8]">@item.TimeAgo</span>
                                </div>
                            </div>

                            @* Arrow if clickable *@
                            @if (item.ActionLink != null)
                            {
                                <span class="material-symbols-outlined text-[#617789] dark:text-[#94a3b8] text-base self-center shrink-0">
                                    chevron_right
                                </span>
                            }

                        </a>
                    }
                </div>

            </div>
        }
    </div>
}
