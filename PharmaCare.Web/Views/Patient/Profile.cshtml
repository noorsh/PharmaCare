@model PharmaCare.Data.Models.Patient
@using PharmaCare.MVC.Extensions
@{
    ViewData["Title"] = "My Profile";
    Layout = "_LayoutAuth";
}

@* Note: Tailwind CSS is loaded in _LayoutAuth.cshtml *@

<!-- Page Header Section -->
<div class="flex flex-wrap items-center justify-between gap-4 bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
    <div class="flex flex-col gap-1">
        <h1 class="text-slate-900 dark:text-white text-3xl font-extrabold tracking-tight">Patient Profile View</h1>
        <p class="text-slate-500 text-sm">Review clinical data for AI medication safety checks</p>
    </div>
    <div class="flex items-center gap-4">
        <div class="flex flex-col items-end min-w-40">
            <div class="flex justify-between w-full mb-1">
                <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider">Profile Completion</span>
                <span class="text-xs font-bold text-primary">@ViewBag.ProfileCompletion%</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2.5 overflow-hidden">
                <div class="bg-primary h-full rounded-full" style="width: @ViewBag.ProfileCompletion%;"></div>
            </div>
        </div>
        <a asp-controller="Patient" asp-action="Edit" class="bg-primary hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg font-bold text-sm transition-all flex items-center gap-2 shadow-lg shadow-primary/20">
            <span class="material-symbols-outlined text-lg">edit</span>
            Edit Profile
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
    <!-- Left Column: Health & Safety (Critical Info) -->
    <div class="lg:col-span-2 flex flex-col gap-6">
        <!-- Critical Safety Flags -->
        <section class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-outlined text-rose-500">warning</span>
                <h2 class="text-slate-900 dark:text-white text-lg font-bold">Critical Safety Flags</h2>
            </div>
            <p class="text-slate-500 text-sm mb-6 italic">These flags are used by AI to automatically block contra-indicated medications.</p>
            
            @if (!Model.IsPregnant && !Model.IsBreastfeeding && !Model.HasKidneyDisease && !Model.HasLiverDisease && !Model.HasDrugAllergies)
            {
                <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800/30 p-4 rounded-lg">
                    <div class="flex items-center gap-2 text-green-700 dark:text-green-300">
                        <span class="material-symbols-outlined">check_circle</span>
                        <p class="font-semibold">No active safety flags</p>
                    </div>
                </div>
            }
            else
            {
                <div class="flex flex-wrap gap-4">
                    <!-- Pregnancy Badge -->
                    @if (Model.IsPregnant)
                    {
                        <div class="flex items-center gap-3 px-5 py-4 rounded-xl bg-pink-50 dark:bg-pink-900/20 border border-pink-100 dark:border-pink-800/30 flex-1 min-w-[200px]">
                            <div class="bg-pink-500 text-white size-10 rounded-full flex items-center justify-center">
                                <span class="material-symbols-outlined">pregnant_woman</span>
                            </div>
                            <div>
                                <p class="text-pink-900 dark:text-pink-200 font-bold text-base leading-tight">Pregnancy</p>
                                <p class="text-pink-700 dark:text-pink-400 text-xs font-medium">Currently Active</p>
                            </div>
                            <span class="material-symbols-outlined text-pink-500 ml-auto">verified</span>
                        </div>
                    }
                    
                    <!-- Breastfeeding Badge -->
                    @if (Model.IsBreastfeeding)
                    {
                        <div class="flex items-center gap-3 px-5 py-4 rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800/30 flex-1 min-w-[200px]">
                            <div class="bg-blue-500 text-white size-10 rounded-full flex items-center justify-center">
                                <span class="material-symbols-outlined">child_care</span>
                            </div>
                            <div>
                                <p class="text-blue-900 dark:text-blue-200 font-bold text-base leading-tight">Breastfeeding</p>
                                <p class="text-blue-700 dark:text-blue-400 text-xs font-medium">Currently Active</p>
                            </div>
                            <span class="material-symbols-outlined text-blue-500 ml-auto">verified</span>
                        </div>
                    }
                    
                    <!-- Kidney Disease Badge -->
                    @if (Model.HasKidneyDisease)
                    {
                        <div class="flex items-center gap-3 px-5 py-4 rounded-xl bg-orange-50 dark:bg-orange-900/20 border border-orange-100 dark:border-orange-800/30 flex-1 min-w-[200px]">
                            <div class="bg-orange-500 text-white size-10 rounded-full flex items-center justify-center">
                                <span class="material-symbols-outlined">health_and_safety</span>
                            </div>
                            <div>
                                <p class="text-orange-900 dark:text-orange-200 font-bold text-base leading-tight">Kidney Disease</p>
                                <p class="text-orange-700 dark:text-orange-400 text-xs font-medium">Chronic Condition</p>
                            </div>
                            <span class="material-symbols-outlined text-orange-500 ml-auto">verified</span>
                        </div>
                    }
                    
                    <!-- Liver Disease Badge -->
                    @if (Model.HasLiverDisease)
                    {
                        <div class="flex items-center gap-3 px-5 py-4 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-100 dark:border-amber-800/30 flex-1 min-w-[200px]">
                            <div class="bg-amber-500 text-white size-10 rounded-full flex items-center justify-center">
                                <span class="material-symbols-outlined">health_and_safety</span>
                            </div>
                            <div>
                                <p class="text-amber-900 dark:text-amber-200 font-bold text-base leading-tight">Liver Disease</p>
                                <p class="text-amber-700 dark:text-amber-400 text-xs font-medium">Chronic Condition</p>
                            </div>
                            <span class="material-symbols-outlined text-amber-500 ml-auto">verified</span>
                        </div>
                    }
                    
                    <!-- Drug Allergies Badge -->
                    @if (Model.HasDrugAllergies)
                    {
                        <div class="flex flex-col gap-2 px-5 py-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800/30 flex-1 min-w-full">
                            <div class="flex items-center gap-3">
                                <div class="bg-red-500 text-white size-10 rounded-full flex items-center justify-center">
                                    <span class="material-symbols-outlined">medication</span>
                                </div>
                                <div class="flex-1">
                                    <p class="text-red-900 dark:text-red-200 font-bold text-base leading-tight">Drug Allergies</p>
                                    <p class="text-red-700 dark:text-red-400 text-xs font-medium">Critical Alert</p>
                                </div>
                                <span class="material-symbols-outlined text-red-500">verified</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.DrugAllergyDetails))
                            {
                                <div class="ml-14 bg-red-100/50 dark:bg-red-900/10 p-3 rounded-lg">
                                    <p class="text-red-800 dark:text-red-300 text-sm font-medium">@Model.DrugAllergyDetails</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>

        <!-- Personal Information -->
        <section class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center gap-2 mb-6">
                <span class="material-symbols-outlined text-primary">person</span>
                <h2 class="text-slate-900 dark:text-white text-lg font-bold">Personal Information</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                <div class="flex flex-col gap-1.5">
                    <label class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">badge</span> Full Name
                    </label>
                    <p class="text-slate-900 dark:text-white font-semibold">@Model.User?.FirstName @Model.User?.LastName</p>
                </div>
                
                <div class="flex flex-col gap-1.5">
                    <label class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">event</span> Date of Birth
                    </label>
                    <p class="text-slate-900 dark:text-white font-semibold">
                        @Model.DateOfBirth.ToString("MMMM dd, yyyy") 
                        @if (ViewBag.Age != null)
                        {
                            <span class="text-slate-500">(@ViewBag.Age years)</span>
                        }
                    </p>
                </div>
                
                <div class="flex flex-col gap-1.5">
                    <label class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">wc</span> Gender
                    </label>
                    <p class="text-slate-900 dark:text-white font-semibold">@Model.Gender</p>
                </div>
                
                <div class="flex flex-col gap-1.5">
                    <label class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">mail</span> Email Address
                    </label>
                    <p class="text-slate-900 dark:text-white font-semibold">@Model.User.Email</p>
                </div>
                
                <div class="flex flex-col gap-1.5">
                    <label class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">call</span> Phone Number
                    </label>
                    <p class="text-slate-900 dark:text-white font-semibold">@(Model.User.PhoneNumber ?? "Not provided")</p>
                </div>
                
                <div class="flex flex-col gap-1.5">
                    <label class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">location_on</span> Home Address
                    </label>
                    <p class="text-slate-900 dark:text-white font-semibold leading-relaxed">
                        @if (!string.IsNullOrEmpty(Model.Address))
                        {
                            @Model.Address
                            if (!string.IsNullOrEmpty(Model.City))
                            {
                                <text>, @Model.City</text>
                            }
                        }
                        else
                        {
                            <span class="text-slate-400 italic">Not provided</span>
                        }
                    </p>
                </div>
            </div>
        </section>

        <!-- Lifestyle Factors -->
        <section class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center gap-2 mb-6">
                <span class="material-symbols-outlined text-primary">style</span>
                <h2 class="text-slate-900 dark:text-white text-lg font-bold">Lifestyle Factors</h2>
            </div>
            <div class="flex flex-wrap gap-3">
                <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-4 py-3 rounded-xl">
                    <span class="material-symbols-outlined text-slate-500">smoke_free</span>
                    <div>
                        <p class="text-slate-900 dark:text-white text-sm font-bold">@(Model.SmokingStatus?.ToString() ?? "Not specified")</p>
                        <p class="text-slate-500 text-[10px] uppercase tracking-widest font-bold">Smoking Status</p>
                    </div>
                </div>
                
                <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-4 py-3 rounded-xl">
                    <span class="material-symbols-outlined text-amber-500">liquor</span>
                    <div>
                        <p class="text-slate-900 dark:text-white text-sm font-bold">@(Model.AlcoholConsumption?.ToString() ?? "Not specified")</p>
                        <p class="text-slate-500 text-[10px] uppercase tracking-widest font-bold">Alcohol Intake</p>
                    </div>
                </div>
                
                <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-4 py-3 rounded-xl">
                    <span class="material-symbols-outlined text-emerald-500">fitness_center</span>
                    <div>
                        <p class="text-slate-900 dark:text-white text-sm font-bold">@(Model.ExerciseFrequency?.ToString() ?? "Not specified")</p>
                        <p class="text-slate-500 text-[10px] uppercase tracking-widest font-bold">Exercise Frequency</p>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Additional Notes -->
        @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
        {
            <section class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex items-center gap-2 mb-4">
                    <span class="material-symbols-outlined text-primary">notes</span>
                    <h2 class="text-slate-900 dark:text-white text-lg font-bold">Additional Notes</h2>
                </div>
                <p class="text-slate-700 dark:text-slate-300 leading-relaxed">@Model.AdditionalNotes</p>
            </section>
        }
    </div>

    <!-- Right Column: Quick Links & Info -->
    <div class="flex flex-col gap-6">
        <!-- Health Records Summary -->
        <section class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-outlined text-primary">folder_shared</span>
                <h2 class="text-slate-900 dark:text-white text-lg font-bold">Health Summary</h2>
            </div>
            <div class="space-y-4">
                <div class="flex justify-between items-center py-2 border-b border-slate-50 dark:border-slate-800">
                    <span class="text-sm text-slate-500">Blood Type</span>
                    <span class="text-sm font-bold text-slate-900 dark:text-white">
                        @(Model.BloodType?.GetDisplayName() ?? "Unknown")
                    </span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-slate-50 dark:border-slate-800">
                    <span class="text-sm text-slate-500">Height</span>
                    <span class="text-sm font-bold text-slate-900 dark:text-white">
                        @if (Model.Height.HasValue)
                        {
                            @Model.Height.Value.ToString("0.0") <text> cm</text>
                        }
                        else
                        {
                            <text>Not provided</text>
                        }
                    </span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-slate-50 dark:border-slate-800">
                    <span class="text-sm text-slate-500">Weight</span>
                    <span class="text-sm font-bold text-slate-900 dark:text-white">
                        @if (Model.Weight.HasValue)
                        {
                            @Model.Weight.Value.ToString("0.0") <text> kg</text>
                        }
                        else
                        {
                            <text>Not provided</text>
                        }
                    </span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-slate-50 dark:border-slate-800">
                    <span class="text-sm text-slate-500">Known Allergies</span>
                    <a asp-controller="Patient" asp-action="Allergies" class="text-sm font-bold text-rose-500 hover:text-rose-600">@ViewBag.AllergiesCount</a>
                </div>
                <div class="flex justify-between items-center py-2">
                    <span class="text-sm text-slate-500">Medical Conditions</span>
                    <a asp-controller="Patient" asp-action="MedicalHistory" class="text-sm font-bold text-primary hover:text-blue-600">@ViewBag.MedicalHistoryCount</a>
                </div>
            </div>
        </section>

        <!-- AI Safety Note -->
        <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 p-5 rounded-xl">
            <div class="flex items-center gap-2 mb-2 text-primary">
                <span class="material-symbols-outlined text-base">smart_toy</span>
                <h3 class="font-bold text-sm">AI Medication Check</h3>
            </div>
            <p class="text-slate-600 dark:text-slate-400 text-xs leading-relaxed">
                Our AI system cross-references your profile data with medication databases to ensure your safety. Keep your profile updated to avoid potential drug interactions.
            </p>
        </div>
        
        <!-- Last Updated -->
        <div class="text-center text-xs text-slate-400 py-4">
            <p>Profile last updated</p>
            <p class="font-semibold mt-1">@(Model.UpdatedAt?.ToString("MMMM dd, yyyy") ?? Model.CreatedAt.ToString("MMMM dd, yyyy"))</p>
        </div>
    </div>
</div>